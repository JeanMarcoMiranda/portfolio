---
/**
 * @component SeriesIndex
 * @description Sidebar de navegación para posts de series multi-fase.
 * Muestra todas las fases y pasos de la serie, con el paso actual resaltado
 * e indicador de progreso.
 */

interface SeriesPost {
  slug: string;
  data: {
    title: string;
    series?: string;
    seriesTitle?: string;
    phase?: number;
    phaseTitle?: string;
    step?: number;
    stepTitle?: string;
    order?: number;
  };
}

interface Props {
  seriesPosts: SeriesPost[];
  currentSlug: string;
  seriesTitle: string;
}

const { seriesPosts, currentSlug, seriesTitle } = Astro.props;

// Ordenar por orden global
const sorted = [...seriesPosts].sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

// Agrupar por fase
const phases = sorted.reduce(
  (acc, post) => {
    const phaseNum = post.data.phase ?? 1;
    const phaseTitle = post.data.phaseTitle ?? `Fase ${phaseNum}`;
    if (!acc[phaseNum]) {
      acc[phaseNum] = { title: phaseTitle, posts: [] };
    }
    acc[phaseNum].posts.push(post);
    return acc;
  },
  {} as Record<number, { title: string; posts: SeriesPost[] }>
);

const phaseEntries = Object.entries(phases).sort(
  ([a], [b]) => Number(a) - Number(b)
);

// Calcular progreso
const currentIndex = sorted.findIndex((p) => p.slug === currentSlug);
const totalPages = sorted.length;
const progressPercent =
  totalPages > 1 ? Math.round(((currentIndex + 1) / totalPages) * 100) : 100;
---

<!-- Sidebar de escritorio — se inyecta en el layout de la página de serie -->
<aside
  id="series-sidebar"
  class="series-sidebar"
  aria-label="Índice de la serie"
>
  <!-- Cabecera de la serie -->
  <div class="sidebar-header">
    <div class="sidebar-label">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
        ></path>
      </svg>
      <span>Serie</span>
    </div>
    <h2 class="sidebar-title">{seriesTitle}</h2>

    <!-- Barra de progreso -->
    <div class="progress-container" title={`Página ${currentIndex + 1} de ${totalPages}`}>
      <div class="progress-bar-track">
        <div
          class="progress-bar-fill"
          style={`width: ${progressPercent}%`}
        >
        </div>
      </div>
      <span class="progress-label">
        {currentIndex + 1} / {totalPages}
      </span>
    </div>
  </div>

  <!-- Índice por fases -->
  <nav class="sidebar-nav" aria-label="Páginas de la serie">
    {
      phaseEntries.map(([phaseNum, phase]) => (
        <div class="phase-group">
          <div class="phase-header">
            <span class="phase-badge">Fase {phaseNum}</span>
            <span class="phase-title">{phase.title}</span>
          </div>
          <ul class="step-list" role="list">
            {phase.posts.map((post) => {
              const isCurrent = post.slug === currentSlug;
              return (
                <li>
                  <a
                    href={`/blog/${post.slug}`}
                    class:list={["step-link", { "step-link--active": isCurrent }]}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    <span class:list={["step-indicator", { "step-indicator--active": isCurrent }]}>
                      {isCurrent ? (
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                          <circle cx="12" cy="12" r="10"/>
                        </svg>
                      ) : (
                        <span class="step-number">{post.data.step}</span>
                      )}
                    </span>
                    <span class="step-text">
                      {post.data.stepTitle ?? post.data.title}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>

  <!-- Toggle para móvil (controlado por JS) -->
  <button
    id="series-sidebar-toggle"
    class="sidebar-mobile-toggle"
    aria-expanded="false"
    aria-controls="series-sidebar-content"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>
</aside>

<style>
  .series-sidebar {
    position: sticky;
    top: 5.5rem;
    height: fit-content;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    width: 280px;
    flex-shrink: 0;
    background: var(--card);
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 1.25rem;
    padding: 1.25rem;
    scroll-behavior: smooth;

    /* Scrollbar estilizado */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--border) 80%, transparent) transparent;
  }

  .series-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .series-sidebar::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: 4px;
  }

  /* Cabecera */
  .sidebar-header {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .sidebar-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .sidebar-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--foreground);
    line-height: 1.35;
    margin: 0 0 0.85rem;
    font-family: var(--font-heading, sans-serif);
  }

  /* Progreso */
  .progress-container {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .progress-bar-track {
    flex: 1;
    height: 5px;
    background: color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 9999px;
    overflow: hidden;
  }
  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--primary),
      color-mix(in srgb, var(--primary) 70%, transparent)
    );
    border-radius: 9999px;
    transition: width 0.4s ease;
  }
  .progress-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  /* Navegación */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .phase-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .phase-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .phase-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
    white-space: nowrap;
  }

  .phase-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted-foreground);
    line-clamp: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Lista de pasos */
  .step-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step-link {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.65rem;
    text-decoration: none;
    transition: all 0.2s ease;
    color: var(--muted-foreground);
    border: 1px solid transparent;
  }
  .step-link:hover {
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    color: var(--foreground);
    border-color: color-mix(in srgb, var(--border) 50%, transparent);
  }
  .step-link--active {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 25%, transparent);
    font-weight: 600;
  }
  .step-link--active:hover {
    background: color-mix(in srgb, var(--primary) 15%, transparent);
    color: var(--primary);
  }

  .step-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--border) 50%, transparent);
    margin-top: 1px;
    transition: all 0.2s ease;
  }
  .step-indicator--active {
    background: var(--primary);
    color: white;
  }
  .step-number {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--muted-foreground);
  }
  .step-indicator--active .step-number {
    color: white;
  }

  .step-text {
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* Botón toggle para móvil (oculto en desktop) */
  .sidebar-mobile-toggle {
    display: none;
  }
</style>
