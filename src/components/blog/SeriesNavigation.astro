---
/**
 * @component SeriesNavigation
 * @description Navegación prev/next entre páginas de una serie.
 * Muestra el título del capítulo anterior y siguiente con estilo premium.
 */

interface NavPost {
  slug: string;
  data: {
    stepTitle?: string;
    title: string;
    phase?: number;
    phaseTitle?: string;
    step?: number;
    order?: number;
  };
}

interface Props {
  prevPost?: NavPost;
  nextPost?: NavPost;
  currentIndex: number;
  totalPages: number;
}

const { prevPost, nextPost, currentIndex, totalPages } = Astro.props;
---

<nav class="series-navigation" aria-label="Navegación entre páginas de la serie">

  <!-- Indicador de posición central -->
  <div class="nav-position">
    <span class="nav-position-text">
      Página <strong>{currentIndex + 1}</strong> de <strong>{totalPages}</strong>
    </span>
  </div>

  <div class="nav-grid">
    <!-- Anterior -->
    <div class="nav-slot nav-slot--prev">
      {prevPost ? (
        <a href={`/blog/${prevPost.slug}`} class="nav-card nav-card--prev" aria-label={`Página anterior: ${prevPost.data.stepTitle ?? prevPost.data.title}`}>
          <div class="nav-card-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </div>
          <div class="nav-card-content">
            <span class="nav-card-label">Anterior</span>
            <span class="nav-card-chapter">
              Fase {prevPost.data.phase} · Paso {prevPost.data.step}
            </span>
            <span class="nav-card-title">
              {prevPost.data.stepTitle ?? prevPost.data.title}
            </span>
          </div>
        </a>
      ) : (
        <div class="nav-card nav-card--disabled" aria-hidden="true">
          <div class="nav-card-arrow nav-card-arrow--dim">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </div>
          <div class="nav-card-content">
            <span class="nav-card-label">Primera página</span>
            <span class="nav-card-title nav-card-title--dim">Esta es la primera página de la serie</span>
          </div>
        </div>
      )}
    </div>

    <!-- Siguiente -->
    <div class="nav-slot nav-slot--next">
      {nextPost ? (
        <a href={`/blog/${nextPost.slug}`} class="nav-card nav-card--next" aria-label={`Página siguiente: ${nextPost.data.stepTitle ?? nextPost.data.title}`}>
          <div class="nav-card-content nav-card-content--right">
            <span class="nav-card-label">Siguiente</span>
            <span class="nav-card-chapter">
              Fase {nextPost.data.phase} · Paso {nextPost.data.step}
            </span>
            <span class="nav-card-title">
              {nextPost.data.stepTitle ?? nextPost.data.title}
            </span>
          </div>
          <div class="nav-card-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </a>
      ) : (
        <div class="nav-card nav-card--disabled nav-card--next" aria-hidden="true">
          <div class="nav-card-content nav-card-content--right">
            <span class="nav-card-label">Serie completada</span>
            <span class="nav-card-title nav-card-title--dim">¡Llegaste al final! 🎉</span>
          </div>
          <div class="nav-card-arrow nav-card-arrow--dim">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </div>
        </div>
      )}
    </div>
  </div>
</nav>

<style>
  .series-navigation {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  /* Posición central */
  .nav-position {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .nav-position-text {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }
  .nav-position-text strong {
    color: var(--primary);
  }

  /* Grid de navegación */
  .nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 580px) {
    .nav-grid {
      grid-template-columns: 1fr;
    }
    .nav-slot--next {
      order: -1; /* En móvil, el "siguiente" va arriba */
    }
  }

  .nav-slot {
    min-width: 0;
  }

  /* Tarjetas de navegación */
  .nav-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    background: var(--card);
    text-decoration: none;
    color: var(--foreground);
    transition: all 0.25s ease;
    height: 100%;
  }

  a.nav-card:hover {
    border-color: color-mix(in srgb, var(--primary) 40%, transparent);
    background: color-mix(in srgb, var(--primary) 5%, var(--card));
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .nav-card--next {
    justify-content: flex-end;
    text-align: right;
  }

  .nav-card--disabled {
    opacity: 0.5;
    cursor: default;
    border-style: dashed;
  }

  /* Flecha */
  .nav-card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    color: var(--primary);
    transition: all 0.25s ease;
  }
  a.nav-card:hover .nav-card-arrow {
    background: var(--primary);
    color: white;
    transform: scale(1.08);
  }
  .nav-card-arrow--dim {
    background: color-mix(in srgb, var(--muted) 50%, transparent);
    color: var(--muted-foreground);
  }

  /* Contenido */
  .nav-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .nav-card-content--right {
    align-items: flex-end;
  }

  .nav-card-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .nav-card-chapter {
    font-size: 0.7rem;
    color: var(--muted-foreground);
    font-weight: 500;
  }
  .nav-card-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--foreground);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .nav-card-title--dim {
    color: var(--muted-foreground);
    font-weight: 400;
  }
</style>
