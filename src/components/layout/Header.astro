---
import ThemeToggle from "../ui/ThemeToggle.astro";
---

<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border-b border-slate-200/50 dark:border-slate-700/50 shadow-sm">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
        <!-- Logo -->
        <a href="#hero" class="group relative">
            <div
                class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white transition-all duration-300 group-hover:scale-105"
            >
                <span class="relative">
                    JM
                    <div
                        class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-300 group-hover:w-full"
                    >
                    </div>
                </span>
            </div>
        </a>

        <!-- Navegacion -->
        <ul
            class="hidden md:flex gap-8 text-slate-600 dark:text-slate-300 font-medium"
        >
            <li>
                <a
                    href="#about"
                    class="relative py-2 px-1 transition-all duration-300 hover:text-slate-900 dark:hover:text-white group"
                >
                    Sobre mí
                    <span
                        class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-300 group-hover:w-full"
                    ></span>
                </a>
            </li>
            <li>
                <a
                    href="#projects"
                    class="relative py-2 px-1 transition-all duration-300 hover:text-slate-900 dark:hover:text-white group"
                >
                    Proyectos
                    <span
                        class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-300 group-hover:w-full"
                    ></span>
                </a>
            </li>
            <li>
                <a
                    href="#contact"
                    class="relative py-2 px-1 transition-all duration-300 hover:text-slate-900 dark:hover:text-white group"
                >
                    Contáctame
                    <span
                        class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-300 group-hover:w-full"
                    ></span>
                </a>
            </li>
        </ul>

        <!-- Boton menu movil -->
        <button
            id="mobile-menu-button"
            class="md:hidden p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all duration-300"
            aria-label="Abrir menú"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <!-- Toggle para cambiar el tema -->
        <div class="hidden md:block">
            <ThemeToggle />
        </div>
    </nav>

    <!-- Menu movil -->
    <div
        id="mobile-menu"
        class="hidden md:hidden bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200/50 dark:border-slate-700/50"
    >
        <div class="px-6 py-4 space-y-4">
            <a
                href="#about"
                class="block py-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors duration-300"
            >
                Sobre mí
            </a>
            <a
                href="#projects"
                class="block py-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors duration-300"
            >
                Proyectos
            </a>
            <a
                href="#contact"
                class="block py-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors duration-300"
            >
                Contáctame
            </a>
            <div class="pt-2 border-t border-slate-200 dark:border-slate-700">
                <ThemeToggle />
            </div>
        </div>
    </div>
</header>

<script>
    // Script para el menu movil
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    mobileMenuButton?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
    });

    // Cerrar menu al hacer click en un enlace
    const mobileLinks = mobileMenu?.querySelectorAll("a");
    mobileLinks?.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu?.classList.add("hidden");
        });
    });
</script>
