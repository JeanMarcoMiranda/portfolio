---
/**
 * @file Header.astro
 * @description Main navigation header component with responsive design, mobile menu, and theme/language toggles.
 */
import ThemeToggle from "../ui/ThemeToggle.astro";
import LanguageToggle from "../ui/LanguageToggle.astro";

/**
 * Interface defining the structure of navigation links
 */
interface NavLink {
  /** URL destination of the link */
  href: string;
  /** Display text of the link */
  label: string;
}

const navLinks: NavLink[] = [
  { href: "#about", label: "Sobre mí" },
  { href: "#projects", label: "Proyectos" },
  { href: "#contact", label: "Contacto" },
];
---

<header
  class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-background/90 border-b border-border/30"
>
  <nav class="container flex items-center justify-between py-3">
    <!-- Logo compacto -->
    <a
      href="#hero"
      class="group relative outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md"
      aria-label="Ir al inicio"
    >
      <div
        class="text-xl font-bold text-foreground transition-transform duration-300 group-hover:scale-105"
      >
        <span class="relative">
          JM
          <span
            class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"
            aria-hidden="true"></span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation compacto -->
    <ul class="hidden md:flex gap-6 text-sm">
      <li>
        <a
          href="#about"
          id="nav-about"
          class="nav-link relative py-1.5 px-2 text-muted-foreground transition-colors duration-300 hover:text-foreground group outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
        >
          Sobre mí
          <span
            class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"
            aria-hidden="true"></span>
        </a>
      </li>
      <li>
        <a
          href="#projects"
          id="nav-projects"
          class="nav-link relative py-1.5 px-2 text-muted-foreground transition-colors duration-300 hover:text-foreground group outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
        >
          Proyectos
          <span
            class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"
            aria-hidden="true"></span>
        </a>
      </li>
      <li>
        <a
          href="#contact"
          id="nav-contact"
          class="nav-link relative py-1.5 px-2 text-muted-foreground transition-colors duration-300 hover:text-foreground group outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm"
        >
          Contacto
          <span
            class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"
            aria-hidden="true"></span>
        </a>
      </li>
    </ul>

    <!-- Actions compactas -->
    <div class="flex items-center gap-2">
      <div class="hidden md:flex items-center gap-2">
        <LanguageToggle />
        <ThemeToggle />
      </div>

      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg bg-card border border-border hover:bg-muted transition-colors outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-5 h-5 text-foreground"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu compacto -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-background/95 backdrop-blur-md border-t border-border/30"
    role="navigation"
    aria-label="Menú móvil"
  >
    <div class="px-4 py-3 space-y-2">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class="mobile-nav-link block py-2 px-3 text-sm text-muted-foreground hover:text-foreground hover:bg-muted rounded-lg transition-colors outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            {label}
          </a>
        ))
      }

      <div class="pt-3 mt-2 border-t border-border/30">
        <div class="flex items-center justify-between px-3 py-2">
          <span class="text-xs text-muted-foreground">Tema</span>
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  type MenuState = "open" | "closed";

  const mobileMenuButton = document.getElementById(
    "mobile-menu-button",
  ) as HTMLButtonElement | null;
  const mobileMenu = document.getElementById(
    "mobile-menu",
  ) as HTMLElement | null;

  /**
   * Sets the visibility state of the mobile menu
   * @param {MenuState} state - The desired state ('open' or 'closed')
   */

  const setMenuState = (state: MenuState): void => {
    if (!mobileMenuButton || !mobileMenu) return;

    const isOpen = state === "open";

    mobileMenu.classList.toggle("hidden", !isOpen);
    mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
    mobileMenuButton.setAttribute(
      "aria-label",
      isOpen ? "Cerrar menú" : "Abrir menú",
    );
  };

  /**
   * Toggles the mobile menu open/closed state
   */
  const toggleMenu = (): void => {
    if (!mobileMenu) return;
    const isHidden = mobileMenu.classList.contains("hidden");
    setMenuState(isHidden ? "open" : "closed");
  };

  /**
   * Closes the mobile menu
   */
  const closeMenu = (): void => {
    setMenuState("closed");
  };

  mobileMenuButton?.addEventListener("click", toggleMenu);

  const mobileLinks =
    mobileMenu?.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link");
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && !mobileMenu?.classList.contains("hidden")) {
      closeMenu();
      mobileMenuButton?.focus();
    }
  });

  document.addEventListener("click", (e: MouseEvent) => {
    const target = e.target as Node;
    if (
      mobileMenu &&
      !mobileMenu.classList.contains("hidden") &&
      !mobileMenu.contains(target) &&
      !mobileMenuButton?.contains(target)
    ) {
      closeMenu();
    }
  });
</script>
