---
// AboutMe.astro - Diseño Minimalista y Compacto
import AboutIcon from "../ui/AboutIcon.astro";
import {
    siAndroid,
    siKotlin,
    siReact,
    siAstro,
    siTypescript,
    siTailwindcss,
} from "simple-icons/icons";

const techStack = [
    siAndroid,
    siKotlin,
    siReact,
    siAstro,
    siTypescript,
    siTailwindcss,
];

const cards: {
    title: string;
    description: string;
    icon: "code" | "education" | "projects";
    highlighted: boolean;
}[] = [
    {
        title: "Especialización",
        description: "Desarrollo Frontend y Aplicaciones móviles Nativas",
        icon: "code",
        highlighted: true,
    },
    {
        title: "Educación",
        description: "Tecnico en Desarrollo de software - TECSUP",
        icon: "education",
        highlighted: false,
    },
    {
        title: "Educación",
        description:
            "Egresado en Ingenieria de Sistemas - Universidad Tecnológica del Perú (UTP)",
        icon: "education",
        highlighted: false,
    },
    {
        title: "Proyectos",
        description: "Más de 5 proyectos relevantes construidos",
        icon: "projects",
        highlighted: false,
    },
];
---

<section
    id="about"
    class="section bg-background relative overflow-hidden py-16 lg:py-20"
>
    <!-- Decoración minimalista -->
    <div
        class="absolute top-20 right-0 w-64 h-64 bg-primary/3 rounded-full blur-3xl"
    >
    </div>

    <div class="container relative z-10 max-w-6xl">
        <!-- Header compacto -->
        <header class="text-center mb-12 lg:mb-16 animate-slide-up">
            <span
                class="inline-block text-xs font-semibold text-primary uppercase tracking-wider mb-2 px-3 py-1 rounded-full bg-primary/5"
            >
                Sobre mí
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-foreground">
                Jean Marco Miranda
            </h2>
        </header>

        <div class="grid lg:grid-cols-5 gap-8 lg:gap-10 items-start">
            <!-- Columna izquierda: Imagen compacta (2 columnas) -->
            <div class="lg:col-span-2 animate-fade-in">
                <div class="relative w-full max-w-[280px] mx-auto">
                    <div
                        class="aspect-[3/4] relative rounded-2xl overflow-hidden shadow-lg border border-border/30 bg-card"
                    >
                        <img
                            src="/profile_photo.jpg"
                            alt="Jean Marco Miranda profile"
                            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                            loading="lazy"
                        />
                    </div>

                    <!-- Badge minimalista -->
                    <div
                        class="absolute -bottom-3 -right-3 w-14 h-14 bg-background border-2 border-primary rounded-xl flex items-center justify-center shadow-lg"
                    >
                        <svg
                            class="w-5 h-5 text-primary"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="2.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                </div>

                <!-- Stack tecnológico compacto y vertical -->
                <div class="mt-8 max-w-[280px] mx-auto">
                    <h3
                        class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-3"
                    >
                        Stack
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {
                            techStack.map((tech) => (
                                <div class="group relative">
                                    <div class="w-10 h-10 bg-card border border-border rounded-lg flex items-center justify-center hover:border-primary transition-all duration-300 hover:shadow-md">
                                        <svg
                                            class="w-5 h-5"
                                            viewBox="0 0 24 24"
                                            fill={`#${tech.hex}`}
                                        >
                                            <path d={tech.path} />
                                        </svg>
                                    </div>
                                    <span class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-foreground text-background text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                        {tech.title}
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Columna derecha: Contenido (3 columnas) -->
            <div class="lg:col-span-3 space-y-6">
                <!-- Bio compacta -->
                <div class="space-y-3">
                    <p class="text-base text-foreground leading-relaxed">
                        <span class="font-semibold text-primary"
                            >Desarrollador Frontend</span
                        > especializado en crear soluciones digitales de alto rendimiento,
                        combinando arquitectura moderna con diseño centrado en UX.
                    </p>
                    <p class="text-sm text-muted-foreground leading-relaxed">
                        Experiencia en proyectos desde aplicaciones móviles
                        nativas hasta sistemas web escalables, con enfoque en
                        eficiencia y código limpio.
                    </p>
                </div>

                <!-- Especialización destacada -->
                <div
                    class="p-4 rounded-xl bg-primary/5 border border-primary/20 relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-full blur-2xl"
                    >
                    </div>
                    <div class="relative flex items-start gap-3">
                        <div class="p-2 bg-primary/10 rounded-lg mt-0.5">
                            <AboutIcon
                                icon="code"
                                class="w-4 h-4 text-primary"
                            />
                        </div>
                        <div class="flex-1">
                            <h3 class="text-sm font-bold text-foreground mb-1">
                                Especialización
                            </h3>
                            <p class="text-xs text-muted-foreground">
                                Desarrollo Frontend y Aplicaciones móviles
                                Nativas
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Grid compacto de información -->
                <div class="grid sm:grid-cols-2 gap-3">
                    <!-- Educación combinada en una sola card -->
                    <div
                        class="p-4 rounded-xl bg-card border border-border hover:border-primary/50 transition-all duration-300 group"
                    >
                        <div class="flex items-start gap-3">
                            <div
                                class="p-2 bg-muted rounded-lg mt-0.5 group-hover:bg-primary/10 transition-colors"
                            >
                                <AboutIcon
                                    icon="education"
                                    class="w-4 h-4 text-primary"
                                />
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3
                                    class="text-sm font-bold text-foreground mb-2"
                                >
                                    Educación
                                </h3>
                                <ul
                                    class="space-y-1.5 text-xs text-muted-foreground"
                                >
                                    <li class="flex items-start gap-1.5">
                                        <span class="text-primary mt-1">•</span>
                                        <span
                                            >Técnico en Desarrollo de Software -
                                            TECSUP</span
                                        >
                                    </li>
                                    <li class="flex items-start gap-1.5">
                                        <span class="text-primary mt-1">•</span>
                                        <span
                                            >Ing. de Sistemas - UTP (Egresado)</span
                                        >
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Proyectos -->
                    <div
                        class="p-4 rounded-xl bg-card border border-border hover:border-primary/50 transition-all duration-300 group"
                    >
                        <div class="flex items-start gap-3">
                            <div
                                class="p-2 bg-muted rounded-lg mt-0.5 group-hover:bg-primary/10 transition-colors"
                            >
                                <AboutIcon
                                    icon="projects"
                                    class="w-4 h-4 text-primary"
                                />
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="text-sm font-bold text-foreground mb-1"
                                >
                                    Proyectos
                                </h3>
                                <p class="text-xs text-muted-foreground">
                                    Más de 5 proyectos relevantes construidos
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quote minimalista -->
                <div class="mt-6 pl-4 border-l-2 border-primary/30">
                    <p class="text-sm text-muted-foreground italic">
                        "Transformando ideas complejas en interfaces intuitivas
                        y rápidas"
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .animate-slide-up {
        animation: slide-up 0.6s ease-out forwards;
    }

    .animate-fade-in {
        animation: fade-in 0.8s ease-out forwards;
    }
</style>
