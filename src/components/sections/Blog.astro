---
import { getCollection } from "astro:content";
import { BookOpen, ArrowRight, Calendar } from "lucide-astro";

// Obtener los posts más recientes
const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section
  id="blog"
  class="section relative py-20 md:py-32 overflow-hidden"
  style="background: linear-gradient(to bottom, hsl(var(--background)), hsl(var(--muted)) 50%, hsl(var(--background)) 100%);"
>
  <!-- Efectos de fondo glassmorphism -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/3 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl animate-pulse-slow"
    >
    </div>
    <div
      class="absolute bottom-1/3 right-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <div class="container relative z-10 max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div
      class="text-center mb-16 md:mb-20 animate-fade-down"
      style="animation-delay: 0.1s;"
    >
      <div class="flex items-center justify-center gap-4 mb-6">
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 backdrop-blur-sm border border-primary/20"
        >
          <BookOpen class="w-4 h-4 text-primary" />
          <span
            class="text-xs font-semibold text-primary uppercase tracking-wider"
          >
            Mi Blog
          </span>
        </div>
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
      </div>

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4">
        <span class="block text-foreground">Últimos</span>
        <span
          class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary to-primary/60"
        >
          Artículos
        </span>
      </h2>

      <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
        Comparto mis conocimientos, aprendizajes y experiencias en el mundo del
        desarrollo de software.
      </p>
    </div>

    <!-- Lista de Posts -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-16"
    >
      {
        recentPosts.map((post: any, index: number) => (
          <article
            class="group relative animate-slide-up h-full flex flex-col"
            style={`animation-delay: ${0.2 + index * 0.1}s;`}
          >
            {/* Glow effect */}
            <div class="absolute -inset-0.5 bg-gradient-to-r from-primary/20 via-accent/20 to-primary/20 rounded-[1.75rem] blur-xl opacity-0 group-hover:opacity-100 transition-all duration-700" />

            {/* Card Principal */}
            <div class="relative flex-1 bg-card/70 backdrop-blur-xl border border-border/50 rounded-[1.5rem] p-6 lg:p-8 hover:border-primary/40 transition-all duration-500 shadow-lg hover:shadow-xl flex flex-col">
              {/* Fecha y Tags */}
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2 text-xs text-muted-foreground font-medium bg-muted/50 px-3 py-1.5 rounded-full border border-border/50">
                  <Calendar class="w-3.5 h-3.5" />
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("es-ES", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </div>
              </div>

              {/* Contenido */}
              <div class="flex-1">
                <h3 class="text-xl font-bold text-foreground mb-3 group-hover:text-primary transition-colors line-clamp-2">
                  <a href={`/blog/${post.slug}`} class="focus:outline-none">
                    <span class="absolute inset-0 z-10" aria-hidden="true" />
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-muted-foreground line-clamp-3 mb-6">
                  {post.data.description}
                </p>
              </div>

              {/* Tags en la parte inferior */}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-border/30">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs font-semibold bg-secondary/60 text-secondary-foreground px-2.5 py-1 rounded-lg border border-border/30 whitespace-nowrap">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <!-- Call to action para ver todos -->
    <div class="text-center animate-fade-up" style="animation-delay: 0.5s;">
      <a
        href="/blog"
        class="group relative inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base rounded-full font-semibold overflow-hidden transition-all duration-300 hover:scale-105"
      >
        <div
          class="absolute inset-0 bg-primary opacity-90 group-hover:opacity-100 transition-opacity"
        >
        </div>
        <div
          class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"
        >
        </div>
        <span class="relative text-primary-foreground flex items-center gap-2">
          <span>Ver todos los posts</span>
          <ArrowRight
            class="w-4 h-4 transition-transform group-hover:translate-x-1"
          />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.05);
    }
  }

  .animate-fade-down {
    animation: fade-down 0.8s ease-out forwards;
    opacity: 0;
  }
  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
    opacity: 0;
  }
  .animate-slide-up {
    animation: slide-up 0.8s ease-out forwards;
    opacity: 0;
  }
  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }
</style>
