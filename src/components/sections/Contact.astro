---
/**
 * @file Contact.astro
 * @description Contact section component with a form and social media links.
 * Features glassmorphism styling and form validation/simulation.
 */
import { Mail, MapPin, Send, Loader2 } from "lucide-astro";
---

<section
  id="contact"
  class="section relative overflow-hidden py-20 md:py-32"
  style="background: linear-gradient(to bottom, hsl(var(--muted)), hsl(var(--background)) 30%, hsl(var(--background)) 70%, hsl(var(--background)) 100%);"
>
  <!-- Efectos de fondo glassmorphism -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/8 rounded-full blur-3xl animate-pulse-slow"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent/8 rounded-full blur-3xl animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <div class="container relative z-10 max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header
      class="text-center mb-16 md:mb-20 animate-fade-down"
      style="animation-delay: 0.1s;"
    >
      <div class="flex items-center justify-center gap-4 mb-6">
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 backdrop-blur-sm border border-primary/20"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
            ></span>
          </span>
          <span
            class="text-xs font-semibold text-primary uppercase tracking-wider"
          >
            Disponible
          </span>
        </div>
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
      </div>

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4">
        <span class="block text-foreground">Hablemos</span>
        <span
          class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary to-primary/60"
        >
          de tu proyecto
        </span>
      </h2>

      <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
        ¿Tienes un proyecto que tengas pensado? Me encantaría escucharlo y
        ayudarte a hacerlo realidad
      </p>
    </header>

    <div class="grid lg:grid-cols-5 gap-8 items-start">
      <!-- Columna izquierda: Info de contacto -->
      <div
        class="lg:col-span-2 space-y-4 animate-slide-right"
        style="animation-delay: 0.2s;"
      >
        <!-- Email Card -->
        <div class="group relative">
          <!-- Glow effect -->
          <div
            class="absolute -inset-1 bg-primary/20 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <!-- Card principal -->
          <div
            class="relative bg-card/50 backdrop-blur-xl border border-border/50 p-5 rounded-2xl hover:border-primary/30 transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div
                class="p-3 bg-primary/10 text-primary rounded-xl group-hover:scale-110 transition-transform duration-300 shrink-0"
              >
                <Mail class="w-6 h-6" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-bold text-foreground mb-1">Email</h3>
                <p class="text-xs text-muted-foreground mb-2">
                  Para proyectos y consultas
                </p>
                <a
                  href="mailto:elecord2014@gmail.com"
                  class="text-sm text-primary font-semibold hover:underline underline-offset-2 break-all block"
                >
                  elecord2014@gmail.com
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Ubicación Card -->
        <div class="group relative">
          <!-- Glow effect -->
          <div
            class="absolute -inset-1 bg-accent/20 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <!-- Card principal -->
          <div
            class="relative bg-card/50 backdrop-blur-xl border border-border/50 p-5 rounded-2xl hover:border-accent/30 transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div
                class="p-3 bg-accent/10 text-accent rounded-xl group-hover:scale-110 transition-transform duration-300 shrink-0"
              >
                <MapPin class="w-6 h-6" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-foreground mb-1">
                  Ubicación
                </h3>
                <p class="text-xs text-muted-foreground mb-1">
                  Trabajo 100% remoto
                </p>
                <p class="text-sm font-semibold text-foreground">
                  Arequipa, Perú 🇵🇪
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Disponibilidad Card -->
        <div class="group relative">
          <!-- Glow effect -->
          <div
            class="absolute -inset-1 bg-primary/20 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>

          <!-- Card principal -->
          <div
            class="relative bg-gradient-to-br from-primary/10 via-primary/5 to-transparent backdrop-blur-xl border border-primary/20 p-5 rounded-2xl hover:border-primary/40 transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div
                class="p-3 bg-primary/20 text-primary rounded-xl group-hover:scale-110 transition-transform duration-300 shrink-0"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-foreground mb-1">
                  Disponibilidad
                </h3>
                <p class="text-xs text-muted-foreground mb-1">
                  Actualmente aceptando proyectos
                </p>
                <div class="flex items-center gap-2 mt-2">
                  <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse">
                  </div>
                  <span
                    class="text-xs font-semibold text-green-600 dark:text-green-400"
                  >
                    Disponible ahora
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="pt-4 animate-fade-in" style="animation-delay: 0.3s;">
          <h3
            class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4"
          >
            Encuéntrame en
          </h3>
          <div class="flex gap-3">
            <a
              href="https://www.linkedin.com/in/jeanmll/"
              target="_blank"
              class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
              aria-label="LinkedIn"
            >
              <div
                class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
              >
              </div>
              <svg
                class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>

            <a
              href="https://github.com/JeanMarcoMiranda"
              target="_blank"
              class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
              aria-label="GitHub"
            >
              <div
                class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
              >
              </div>
              <svg
                class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
            </a>

            <a
              href="mailto:elecord2014@gmail.com"
              class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
              aria-label="Email"
            >
              <div
                class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
              >
              </div>
              <svg
                class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Formulario -->
      <div
        class="lg:col-span-3 group relative animate-slide-left"
        style="animation-delay: 0.3s;"
      >
        <!-- Glow effect para formulario -->
        <div
          class="absolute -inset-2 bg-gradient-to-br from-primary/20 to-accent/20 rounded-3xl blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-700"
        >
        </div>

        <!-- Card del formulario -->
        <div
          class="relative bg-card/50 backdrop-blur-xl border border-border/50 p-6 sm:p-8 rounded-3xl shadow-2xl"
        >
          <form id="contact-form" class="space-y-5">
            <!-- Nombre y Email en grid -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label
                  for="name"
                  class="text-sm font-semibold text-foreground flex items-center gap-2"
                >
                  <span>Nombre</span>
                  <span class="text-destructive">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Tu nombre completo"
                  required
                  class="w-full px-4 py-3 text-sm rounded-xl bg-background/50 backdrop-blur-sm border border-border/50 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/30"
                />
              </div>

              <div class="space-y-2">
                <label
                  for="email"
                  class="text-sm font-semibold text-foreground flex items-center gap-2"
                >
                  <span>Email</span>
                  <span class="text-destructive">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  required
                  class="w-full px-4 py-3 text-sm rounded-xl bg-background/50 backdrop-blur-sm border border-border/50 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/30"
                />
              </div>
            </div>

            <!-- Asunto -->
            <div class="space-y-2">
              <label
                for="subject"
                class="text-sm font-semibold text-foreground flex items-center gap-2"
              >
                <span>Asunto</span>
                <span class="text-destructive">*</span>
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 text-sm rounded-xl bg-background/50 backdrop-blur-sm border border-border/50 text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/30 appearance-none cursor-pointer"
                style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 fill=%27none%27 viewBox=%270 0 24 24%27 stroke=%27%23666%27%3E%3Cpath stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27M19 9l-7 7-7-7%27/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1.25em 1.25em;"
              >
                <option value="" disabled selected>Selecciona una opción</option
                >
                <option value="project">💼 Proyecto nuevo</option>
                <option value="job">🚀 Oferta laboral</option>
                <option value="collaboration">🤝 Colaboración</option>
                <option value="other">💬 Otra consulta</option>
              </select>
            </div>

            <!-- Mensaje -->
            <div class="space-y-2">
              <label
                for="message"
                class="text-sm font-semibold text-foreground flex items-center gap-2"
              >
                <span>Mensaje</span>
                <span class="text-destructive">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Cuéntame más sobre tu proyecto o consulta..."
                required
                class="w-full px-4 py-3 text-sm rounded-xl bg-background/50 backdrop-blur-sm border border-border/50 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all hover:border-primary/30 resize-none"
              ></textarea>
            </div>

            <!-- Botón enviar con glassmorphism -->
            <button
              type="submit"
              class="group relative w-full py-4 px-6 text-base font-semibold rounded-xl overflow-hidden transition-all duration-300 hover:scale-[1.02] focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-70 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            >
              <!-- Glow background -->
              <div
                class="absolute inset-0 bg-gradient-to-r from-primary to-primary/80 opacity-90 group-hover:opacity-100 transition-opacity"
              >
              </div>

              <!-- Shimmer effect -->
              <div
                class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"
              >
              </div>

              <span
                id="btn-text"
                class="relative text-primary-foreground flex items-center gap-2"
              >
                <Send class="w-5 h-5" />
                <span>Enviar mensaje</span>
              </span>

              <span
                id="btn-loader"
                class="hidden relative text-primary-foreground"
              >
                <Loader2 class="w-5 h-5 animate-spin" />
              </span>
            </button>

            <!-- Feedback mensaje -->
            <div
              id="form-feedback"
              class="hidden rounded-xl p-4 text-sm font-medium text-center backdrop-blur-sm animate-fade-in"
            >
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Nota adicional -->
    <div
      class="text-center mt-12 animate-fade-up"
      style="animation-delay: 0.4s;"
    >
      <p class="text-sm text-muted-foreground">
        Respondo todos los mensajes en menos de 24 horas ⚡
      </p>
    </div>
  </div>
</section>

<script>
  /* Form elements selection */
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btnText = document.getElementById("btn-text");
  const btnLoader = document.getElementById("btn-loader");
  const feedback = document.getElementById("form-feedback");

  /**
   * Handles form submission
   * @param {Event} e - The submit event
   */

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;

    submitBtn.disabled = true;
    btnText?.classList.add("hidden");
    btnLoader?.classList.remove("hidden");
    feedback?.classList.add("hidden");

    // Simulate network delay for form submission (replace with actual API call)
    await new Promise((resolve) => setTimeout(resolve, 2000));

    submitBtn.disabled = false;
    btnText?.classList.remove("hidden");
    btnLoader?.classList.add("hidden");

    form.reset();

    if (feedback) {
      feedback.textContent =
        "✅ ¡Mensaje enviado exitosamente! Te responderé pronto.";
      feedback.className =
        "rounded-xl p-4 text-sm font-medium text-center backdrop-blur-sm animate-fade-in bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20 block";
      feedback.classList.remove("hidden");

      setTimeout(() => {
        feedback.classList.add("hidden");
      }, 5000);
    }
  });
</script>

<style>
  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-right {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slide-left {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.05);
    }
  }

  .animate-fade-down {
    animation: fade-down 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-slide-right {
    animation: slide-right 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-slide-left {
    animation: slide-left 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }
</style>
