---
// src/components/Contact.astro
---

<section id="contact" class="section bg-background relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary/5 blur-[120px] rounded-full pointer-events-none -translate-x-1/3 translate-y-1/3"></div>

  <div class="container relative z-10">
    
    <header class="text-center mb-12 sm:mb-16 animate-slide-up">
      <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">
        ¿Tienes una idea?
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground">
        Hablemos
      </h2>
      <p class="mt-4 text-muted-foreground max-w-2xl mx-auto text-lg">
        Estoy disponible para oportunidades freelance y contratos a tiempo completo.
        ¡Construyamos algo increíble juntos!
      </p>
    </header>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      
      <div class="space-y-8 animate-fade-in">
        
        <div class="bg-card border border-border p-6 rounded-2xl shadow-soft hover:shadow-medium transition-all duration-300 group">
          <div class="flex items-start gap-4">
            <div class="p-3 bg-primary/10 text-primary rounded-lg group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground mb-1">Email</h3>
              <p class="text-muted-foreground text-sm mb-2">Para consultas generales y proyectos.</p>
              <a href="mailto:hola@jeanmarco.dev" class="text-primary font-medium hover:underline underline-offset-4">
                hola@jeanmarco.dev
              </a>
            </div>
          </div>
        </div>

        <div class="bg-card border border-border p-6 rounded-2xl shadow-soft hover:shadow-medium transition-all duration-300 group">
          <div class="flex items-start gap-4">
            <div class="p-3 bg-secondary text-secondary-foreground rounded-lg group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-foreground mb-1">Ubicación</h3>
              <p class="text-muted-foreground text-sm">
                Disponible para trabajar en remoto desde cualquier parte del mundo 🌍
              </p>
            </div>
          </div>
        </div>

        <div class="pt-4">
          <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-4">
            Sígueme en redes
          </h3>
          <div class="flex gap-4">
            <a href="#" class="p-3 bg-muted text-muted-foreground rounded-full hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:-translate-y-1" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
            </a>
            <a href="#" class="p-3 bg-muted text-muted-foreground rounded-full hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:-translate-y-1" aria-label="GitHub">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            </a>
            <a href="#" class="p-3 bg-muted text-muted-foreground rounded-full hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:-translate-y-1" aria-label="Twitter">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" /></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="bg-card border border-border p-8 rounded-3xl shadow-strong animate-slide-up" style="animation-delay: 200ms;">
        <form id="contact-form" class="space-y-6">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="text-sm font-medium text-foreground">Nombre</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Tu nombre"
                required
                class="w-full px-4 py-3 rounded-lg bg-background border border-input text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-all"
              />
            </div>
            <div class="space-y-2">
              <label for="email" class="text-sm font-medium text-foreground">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="ejemplo@correo.com"
                required
                class="w-full px-4 py-3 rounded-lg bg-background border border-input text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-all"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="subject" class="text-sm font-medium text-foreground">Asunto</label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-3 rounded-lg bg-background border border-input text-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-all appearance-none"
            >
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="project">Quiero iniciar un proyecto</option>
              <option value="job">Oferta de trabajo</option>
              <option value="other">Otra consulta</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="message" class="text-sm font-medium text-foreground">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Cuéntame los detalles..."
              required
              class="w-full px-4 py-3 rounded-lg bg-background border border-input text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 px-6 bg-primary hover:bg-primary/90 text-primary-foreground font-semibold rounded-lg shadow-md hover:shadow-lg transform transition-all duration-200 hover:-translate-y-0.5 focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-70 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="btn-text">Enviar mensaje</span>
            <svg id="btn-loader" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <svg id="btn-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <div id="form-feedback" class="hidden rounded-lg p-4 text-sm font-medium text-center animate-fade-in"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btnText = document.getElementById("btn-text");
  const btnLoader = document.getElementById("btn-loader");
  const btnIcon = document.getElementById("btn-icon");
  const feedback = document.getElementById("form-feedback");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    
    // 1. Estado de Carga
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    btnText?.classList.add("hidden");
    btnIcon?.classList.add("hidden");
    btnLoader?.classList.remove("hidden");
    feedback?.classList.add("hidden");

    // 2. Simulación de envío (Aquí conectarías con tu backend o servicio como Formspree)
    await new Promise(resolve => setTimeout(resolve, 2000));

    // 3. Estado de Éxito
    submitBtn.disabled = false;
    btnText?.classList.remove("hidden");
    btnIcon?.classList.remove("hidden");
    btnLoader?.classList.add("hidden");
    
    // Resetear formulario
    form.reset();

    // Mostrar mensaje de éxito
    if (feedback) {
      feedback.textContent = "¡Mensaje enviado con éxito! Te responderé pronto.";
      feedback.className = "rounded-lg p-4 text-sm font-medium text-center animate-fade-in bg-success/10 text-success border border-success/20 block mt-4";
      feedback.classList.remove("hidden");
      
      // Ocultar mensaje después de 5 segundos
      setTimeout(() => {
        feedback.classList.add("hidden");
      }, 5000);
    }
  });
</script>