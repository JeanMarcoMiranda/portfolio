---
// src/components/Contact.astro - Minimalista y Compacto
---

<section
  id="contact"
  class="section bg-background relative overflow-hidden py-16 lg:py-20"
>
  <!-- Decoración minimalista -->
  <div
    class="absolute bottom-0 left-0 w-80 h-80 bg-primary/5 blur-3xl rounded-full pointer-events-none"
  >
  </div>

  <div class="container relative z-10 max-w-5xl">
    <!-- Header compacto -->
    <header class="text-center mb-10 animate-slide-up">
      <span
        class="inline-block text-xs font-semibold text-primary uppercase tracking-wider mb-2 px-3 py-1 rounded-full bg-primary/5"
      >
        Contáctame
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-foreground mb-3">
        Hablemos
      </h2>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        Disponible para proyectos freelance y contratos. ¡Construyamos algo
        increíble juntos!
      </p>
    </header>

    <div class="grid lg:grid-cols-5 gap-8 items-start">
      <!-- Columna izquierda: Info de contacto (2 columnas) -->
      <div class="lg:col-span-2 space-y-4 animate-fade-in">
        <!-- Email -->
        <div
          class="bg-card border border-border p-4 rounded-xl hover:border-primary/50 transition-all duration-300 group"
        >
          <div class="flex items-start gap-3">
            <div
              class="p-2 bg-primary/10 text-primary rounded-lg group-hover:scale-105 transition-transform"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold text-foreground mb-0.5">
                Email
              </h3>
              <p class="text-xs text-muted-foreground mb-1">
                Consultas y proyectos
              </p>
              <a
                href="mailto:hola@jeanmarco.dev"
                class="text-sm text-primary font-medium hover:underline underline-offset-2 break-all"
              >
                hola@jeanmarco.dev
              </a>
            </div>
          </div>
        </div>

        <!-- Ubicación -->
        <div
          class="bg-card border border-border p-4 rounded-xl hover:border-primary/50 transition-all duration-300 group"
        >
          <div class="flex items-start gap-3">
            <div
              class="p-2 bg-secondary/10 text-secondary-foreground rounded-lg group-hover:scale-105 transition-transform"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-foreground mb-0.5">
                Ubicación
              </h3>
              <p class="text-xs text-muted-foreground">Remoto 🌍</p>
            </div>
          </div>
        </div>

        <!-- Redes sociales compactas -->
        <div class="pt-2">
          <h3
            class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-3"
          >
            Redes
          </h3>
          <div class="flex gap-2">
            <a
              href="#"
              class="w-9 h-9 flex items-center justify-center bg-muted text-muted-foreground rounded-lg hover:bg-primary hover:text-primary-foreground transition-all duration-300"
              aria-label="LinkedIn"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                ></path></svg
              >
            </a>
            <a
              href="#"
              class="w-9 h-9 flex items-center justify-center bg-muted text-muted-foreground rounded-lg hover:bg-primary hover:text-primary-foreground transition-all duration-300"
              aria-label="GitHub"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path></svg
              >
            </a>
            <a
              href="#"
              class="w-9 h-9 flex items-center justify-center bg-muted text-muted-foreground rounded-lg hover:bg-primary hover:text-primary-foreground transition-all duration-300"
              aria-label="Twitter"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Formulario (3 columnas) -->
      <div
        class="lg:col-span-3 bg-card border border-border p-6 rounded-2xl shadow-lg animate-slide-up"
        style="animation-delay: 100ms;"
      >
        <form id="contact-form" class="space-y-4">
          <!-- Nombre y Email en grid -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" class="text-xs font-medium text-foreground"
                >Nombre</label
              >
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Tu nombre"
                required
                class="w-full px-3 py-2 text-sm rounded-lg bg-background border border-input text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" class="text-xs font-medium text-foreground"
                >Email</label
              >
              <input
                type="email"
                id="email"
                name="email"
                placeholder="ejemplo@correo.com"
                required
                class="w-full px-3 py-2 text-sm rounded-lg bg-background border border-input text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
              />
            </div>
          </div>

          <!-- Asunto -->
          <div class="space-y-1.5">
            <label for="subject" class="text-xs font-medium text-foreground"
              >Asunto</label
            >
            <select
              id="subject"
              name="subject"
              class="w-full px-3 py-2 text-sm rounded-lg bg-background border border-input text-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="project">Proyecto nuevo</option>
              <option value="job">Oferta laboral</option>
              <option value="other">Otra consulta</option>
            </select>
          </div>

          <!-- Mensaje -->
          <div class="space-y-1.5">
            <label for="message" class="text-xs font-medium text-foreground"
              >Mensaje</label
            >
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="Cuéntame los detalles..."
              required
              class="w-full px-3 py-2 text-sm rounded-lg bg-background border border-input text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <!-- Botón enviar -->
          <button
            type="submit"
            class="w-full py-2.5 px-4 bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-semibold rounded-lg shadow-md hover:shadow-lg transform transition-all duration-200 hover:-translate-y-0.5 focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-70 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="btn-text">Enviar mensaje</span>
            <svg
              id="btn-loader"
              class="hidden w-4 h-4 animate-spin"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
            <svg
              id="btn-icon"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

          <!-- Feedback mensaje -->
          <div
            id="form-feedback"
            class="hidden rounded-lg p-3 text-xs font-medium text-center animate-fade-in"
          >
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btnText = document.getElementById("btn-text");
  const btnLoader = document.getElementById("btn-loader");
  const btnIcon = document.getElementById("btn-icon");
  const feedback = document.getElementById("form-feedback");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    submitBtn.disabled = true;
    btnText?.classList.add("hidden");
    btnIcon?.classList.add("hidden");
    btnLoader?.classList.remove("hidden");
    feedback?.classList.add("hidden");

    // Simulación de envío (conectar con backend/Formspree)
    await new Promise((resolve) => setTimeout(resolve, 1500));

    submitBtn.disabled = false;
    btnText?.classList.remove("hidden");
    btnIcon?.classList.remove("hidden");
    btnLoader?.classList.add("hidden");

    form.reset();

    if (feedback) {
      feedback.textContent = "¡Mensaje enviado! Te responderé pronto.";
      feedback.className =
        "rounded-lg p-3 text-xs font-medium text-center animate-fade-in bg-green-500/10 text-green-600 border border-green-500/20 block";
      feedback.classList.remove("hidden");

      setTimeout(() => {
        feedback.classList.add("hidden");
      }, 4000);
    }
  });
</script>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>
