<section
    id="hero"
    class="relative flex min-h-screen flex-col items-center justify-center text-center px-6 bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-gray-950"
>
    <!-- Texto principal -->
    <h1
        class="text-4xl sm:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100"
    >
        Hola, soy <span class="">Jean Marco Miranda</span>
    </h1>

    <h2
        class="mt-4 text-lg sm:text-xl text-gray-600 dark:text-gray-300 max-w-2xl"
    >
        Desarrollador web y mobile enfocado en crear experiencias modernas,
        rapidas y accesibles
    </h2>

    <!-- CTA -->
    <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <a
            href="#projects"
            class="px-6 py-3 rounded-full bg-blue-600 text-white font-medium hover:bg-blue-700 transition-all"
            >Ver Proyectos</a
        >
        <a
            href="#contact"
            class="px-6 py-3 rounded-full border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all"
            >Contactame</a
        >
    </div>

    <!-- Decoracion -->
    <div class="absolute bottom-6 animate-bounce">
        <a href="#about" class="text-gray-500 dark:text-gray-400" aria-label="Siguiente sección"> ↓ </a>
    </div>
</section>
