---
// Hero.astro
---

<section
    id="hero"
    class="relative min-h-screen flex flex-col items-center justify-center py-20 overflow-hidden bg-background"
>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="container relative z-10 flex flex-col items-center text-center space-y-8">
        
        <div class="relative group animate-fade-in">
            <div
                class="absolute -inset-1 bg-gradient-to-r from-primary to-accent rounded-full blur opacity-40 group-hover:opacity-70 transition duration-500"
            >
            </div>
            
            <img
                src="/public/profile_photo.jpg"
                alt="Jean Marco Miranda profile"
                class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-full border-4 border-background shadow-xl object-cover transition-transform duration-500 group-hover:scale-105"
            />
            
            <div
                class="absolute bottom-1 right-1 w-6 h-6 bg-success border-4 border-background rounded-full shadow-sm"
                title="Disponible para trabajar"
            >
            </div>
        </div>

        <div class="space-y-4 max-w-3xl animate-slide-up" style="animation-delay: 100ms;">
            <p class="text-lg font-medium text-muted-foreground">
                ¡Hola! Soy <span class="text-foreground font-bold">Jean Marco Miranda</span> 👋
            </p>

            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-foreground">
                Desarrollador de Software
                <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary to-accent">
                    Mobile & Web
                </span>
            </h1>

            <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
                Transformo ideas en experiencias digitales. Especializado en aplicaciones nativas 
                <span class="text-foreground font-medium">Android</span> y desarrollo web moderno 
                con un enfoque en rendimiento y diseño.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-4 animate-slide-up" style="animation-delay: 200ms;">
            <a
                href="#contact"
                class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-primary text-primary-foreground font-medium shadow-lg shadow-primary/25 hover:bg-primary/90 hover:scale-105 hover:shadow-primary/40 transition-all duration-300"
            >
                <span>Contáctame</span>
                <svg
                    class="w-4 h-4 ml-2"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>

            <a
                href="/resume.pdf"
                target="_blank"
                class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-background border border-border text-foreground font-medium hover:bg-muted hover:border-muted-foreground/30 transition-all duration-300 group"
            >
                <span>Descargar CV</span>
                <svg
                    class="w-4 h-4 ml-2 text-muted-foreground group-hover:text-foreground transition-colors"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
            </a>
        </div>
    </div>

    <a 
        href="#about"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce p-2 rounded-full hover:bg-muted transition-colors cursor-pointer"
        aria-label="Scroll hacia abajo"
    >
        <svg
            class="w-6 h-6 text-muted-foreground"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </a>
</section>