---
// Hero.astro - Glassmorphism Style
import { Clock, Rocket, Code2, Globe } from "lucide-astro";

const roles = [
  "Desarrollador Mobile",
  "Frontend Specialist",
  "Full Stack Developer",
  "UI/UX Enthusiast",
];

const metrics = [
  { value: "3+", labelId: "metric-years", label: "Años", icon: Clock },
  {
    value: "15+",
    labelId: "metric-projects",
    label: "Proyectos",
    icon: Rocket,
  },
  {
    value: "8+",
    labelId: "metric-technologies",
    label: "Tecnologías",
    icon: Code2,
  },
  { value: "100%", labelId: "metric-remote", label: "Remoto", icon: Globe },
];
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center py-20 md:py-24 overflow-hidden"
  style="background: linear-gradient(to bottom, hsl(var(--background)), hsl(var(--background)) 60%, hsl(var(--muted)) 100%);"
>
  <!-- Efectos de fondo glassmorphism -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Grid pattern sutil -->
    <div
      class="absolute inset-0 bg-repeat opacity-[0.02]"
      style="background-image: radial-gradient(var(--color-border) 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>

    <!-- Orbes de fondo animados -->
    <div
      class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl animate-pulse-slow"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/8 rounded-full blur-3xl"
    >
    </div>
  </div>

  <div
    class="container relative z-10 flex flex-col items-center text-center space-y-8 max-w-5xl px-4 sm:px-6"
  >
    <!-- Badge de disponibilidad -->
    <div
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 backdrop-blur-sm border border-primary/20 animate-fade-down"
      style="animation-delay: 0.1s;"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
        ></span>
      </span>
      <span
        class="text-xs sm:text-sm font-semibold text-primary uppercase tracking-wider"
        >Disponible para proyectos</span
      >
    </div>

    <!-- Foto de perfil con efecto glass -->
    <div class="relative group animate-scale-in" style="animation-delay: 0.2s;">
      <!-- Glow effect -->
      <div
        class="absolute -inset-4 bg-gradient-to-r from-primary/30 to-primary/10 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      >
      </div>

      <!-- Anillo exterior -->
      <div
        class="absolute -inset-2 rounded-full border-2 border-primary/20 backdrop-blur-sm"
      >
      </div>

      <!-- Contenedor de imagen -->
      <div
        class="relative w-32 h-32 sm:w-36 sm:h-36 md:w-40 md:h-40 rounded-full border-4 border-background shadow-2xl overflow-hidden"
      >
        <img
          src="/profile_photo.jpg"
          alt="Jean Marco Miranda profile"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />

        <!-- Overlay sutil -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-background/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
      </div>

      <!-- Badge disponibilidad -->
      <div
        class="absolute bottom-2 right-2 w-6 h-6 bg-green-500 border-3 border-background rounded-full shadow-lg animate-pulse-slow"
        title="Disponible para trabajar"
      >
      </div>
    </div>

    <!-- Contenido principal -->
    <div class="space-y-6 animate-fade-up" style="animation-delay: 0.3s;">
      <!-- Título principal con texto rotativo -->
      <div class="space-y-3">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight"
        >
          <span class="block text-foreground mb-2">Jean Marco Miranda</span>
          <span class="block">
            <span
              id="rotating-text"
              class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary to-primary/60 bg-[length:200%_auto] animate-gradient inline-block min-w-[280px] sm:min-w-[380px] md:min-w-[450px]"
            >
              Desarrollador Mobile
            </span>
          </span>
        </h1>
      </div>

      <!-- Descripción -->
      <p
        class="text-base sm:text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed px-4"
      >
        Transformo ideas complejas en <span
          class="text-foreground font-semibold"
          >experiencias digitales excepcionales</span
        >. Especializado en desarrollo móvil y frontend moderno con enfoque en <span
          class="text-foreground font-semibold">arquitectura limpia</span
        > y diseño intuitivo.
      </p>
    </div>

    <!-- Métricas con glassmorphism -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 w-full max-w-3xl animate-fade-up px-4"
      style="animation-delay: 0.4s;"
    >
      {
        metrics.map((metric, index) => (
          <div
            class="metric-card relative group"
            style={`animation-delay: ${0.5 + index * 0.1}s;`}
          >
            {/* Glow effect en hover */}
            <div class="absolute -inset-1 bg-primary/20 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

            {/* Card principal */}
            <div class="relative p-4 sm:p-5 rounded-2xl border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 transition-all duration-500 hover:scale-105">
              <metric.icon class="w-5 h-5 sm:w-6 sm:h-6 mx-auto mb-2 text-primary" />
              <div
                class="text-2xl sm:text-3xl font-bold text-primary metric-number tabular-nums"
                data-target={metric.value}
              >
                0
              </div>
              <div
                class="text-xs sm:text-sm text-muted-foreground mt-1 font-medium"
                id={metric.labelId}
              >
                {metric.label}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Botones de acción con glassmorphism -->
    <div
      class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-4 animate-fade-up px-4"
      style="animation-delay: 0.6s;"
    >
      <a
        href="#contact"
        class="group relative inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base rounded-full font-semibold overflow-hidden transition-all duration-300 hover:scale-105"
      >
        <!-- Glow background -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-primary to-primary/80 opacity-90 group-hover:opacity-100 transition-opacity"
        >
        </div>

        <!-- Shimmer effect -->
        <div
          class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"
        >
        </div>

        <span class="relative text-primary-foreground flex items-center gap-2">
          <span id="hero-cta-contact">Contáctame</span>
          <svg
            class="w-4 h-4 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </span>
      </a>

      <a
        href="/resume.pdf"
        target="_blank"
        class="group relative inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base rounded-full font-semibold border border-border/50 backdrop-blur-xl bg-card/50 text-foreground hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-105"
      >
        <span class="flex items-center gap-2">
          <span>Descargar CV</span>
          <svg
            class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-all group-hover:translate-y-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
        </span>
      </a>
    </div>

    <!-- Links sociales con glassmorphism -->
    <div
      class="flex items-center justify-center gap-3 pt-4 animate-fade-up"
      style="animation-delay: 0.7s;"
    >
      <a
        href="https://github.com/yourusername"
        target="_blank"
        class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
        aria-label="GitHub"
      >
        <div
          class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
        >
        </div>
        <svg
          class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>

      <a
        href="https://linkedin.com/in/yourusername"
        target="_blank"
        class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
        aria-label="LinkedIn"
      >
        <div
          class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
        >
        </div>
        <svg
          class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>

      <a
        href="mailto:your.email@example.com"
        class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
        aria-label="Email"
      >
        <div
          class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
        >
        </div>
        <svg
          class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
      </a>

      <a
        href="https://twitter.com/yourusername"
        target="_blank"
        class="group relative w-11 h-11 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110"
        aria-label="Twitter/X"
      >
        <div
          class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
        >
        </div>
        <svg
          class="relative w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator glassmorphism -->
  <a
    href="#about"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 group cursor-pointer"
    aria-label="Scroll hacia abajo"
  >
    <div
      class="relative w-12 h-12 flex items-center justify-center rounded-full border border-border/50 backdrop-blur-xl bg-card/50 hover:border-primary/30 hover:bg-card/80 transition-all duration-300 hover:scale-110 animate-bounce-slow"
    >
      <div
        class="absolute inset-0 rounded-full bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity blur-md"
      >
      </div>
      <svg
        class="relative w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </a>
</section>

<script define:vars={{ roles }}>
  // Texto rotativo con animación suave
  const textElement = document.getElementById("rotating-text");
  let currentIndex = 0;

  function rotateText() {
    if (!textElement) return;

    // Fade out y slide up
    textElement.style.opacity = "0";
    textElement.style.transform = "translateY(-10px)";

    setTimeout(() => {
      currentIndex = (currentIndex + 1) % roles.length;
      textElement.textContent = roles[currentIndex];

      // Fade in y slide down
      requestAnimationFrame(() => {
        textElement.style.opacity = "1";
        textElement.style.transform = "translateY(0)";
      });
    }, 400);
  }

  // Iniciar rotación después de 3 segundos
  setInterval(rotateText, 4000);
</script>

<script>
  // Animación de conteo para métricas
  const metricNumbers = document.querySelectorAll(".metric-number");

  const animateValue = (element: Element, target: string) => {
    const isPercentage = target.includes("%");
    const isPlus = target.includes("+");
    const numericTarget = parseInt(target);
    const duration = 2000;
    const steps = 60;
    const increment = numericTarget / steps;
    let current = 0;

    const timer = setInterval(() => {
      current += increment;
      if (current >= numericTarget) {
        current = numericTarget;
        clearInterval(timer);
      }
      element.textContent =
        Math.floor(current) + (isPlus ? "+" : "") + (isPercentage ? "%" : "");
    }, duration / steps);
  };

  // Intersection Observer para animar cuando sea visible
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target.getAttribute("data-target");
          if (target) animateValue(entry.target, target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 },
  );

  metricNumbers.forEach((el) => observer.observe(el));
</script>

<style>
  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scale-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.05);
    }
  }

  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes metric-appear {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .animate-fade-down {
    animation: fade-down 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-scale-in {
    animation: scale-in 1s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-gradient {
    animation: gradient 4s ease infinite;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  .animate-bounce-slow {
    animation: bounce-slow 2s ease-in-out infinite;
  }

  #rotating-text {
    transition:
      opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .metric-card {
    animation: metric-appear 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
