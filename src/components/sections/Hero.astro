---
// Hero.astro - Tipografía Reducida
---

<section
    id="hero"
    class="relative min-h-screen flex flex-col items-center justify-center py-20 overflow-hidden bg-background"
>
    
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
        <div class="absolute inset-0 bg-repeat opacity-[0.05]" style="background-image: radial-gradient(var(--color-border) 1px, transparent 1px);"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-radial from-primary/15 to-transparent blur-[100px] rounded-full"></div>
    </div>
    <div class="container relative z-10 flex flex-col items-center text-center space-y-8 md:space-y-10">
        
        <div class="relative group animate-fade-in">
            <div
                class="absolute -inset-1 bg-gradient-to-r from-primary to-accent rounded-full blur opacity-40 group-hover:opacity-80 transition duration-500"
            >
            </div>
            
            <img
                src="/public/profile_photo.jpg"
                alt="Jean Marco Miranda profile"
                class="relative w-36 h-36 md:w-40 md:h-40 rounded-full border-4 border-background shadow-2xl object-cover transition-transform duration-500 group-hover:scale-105"
            />
            
            <div
                class="absolute bottom-2 right-2 w-7 h-7 bg-green-500 border-4 border-background rounded-full shadow-md"
                title="Disponible para trabajar"
            >
            </div>
        </div>

        <div class="space-y-3 md:space-y-4 max-w-4xl animate-slide-up" style="animation-delay: 100ms;">
            
            <p class="text-lg font-medium text-muted-foreground">
                ¡Hola! Soy <span class="text-foreground font-extrabold">Jean Marco Miranda</span> 👋
            </p>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-tight md:leading-tight">
                Desarrollador de Software
                <span class="block mt-1 md:mt-2 text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">
                    Mobile & Web
                </span>
            </h1>

            <p class="text-lg sm:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed pt-2">
                Transformo ideas en experiencias digitales. Especializado en aplicaciones nativas 
                <span class="text-foreground font-semibold">Android</span> y desarrollo web moderno 
                con un enfoque en rendimiento y diseño.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-4 animate-slide-up" style="animation-delay: 200ms;">
            <a
                href="#contact"
                class="inline-flex items-center justify-center px-10 py-4 rounded-full bg-primary text-primary-foreground font-semibold shadow-xl shadow-primary/30 hover:bg-primary/90 hover:scale-[1.02] hover:shadow-primary/50 transition-all duration-300 transform-gpu"
            >
                <span>Contáctame</span>
                <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>

            <a
                href="/resume.pdf"
                target="_blank"
                class="inline-flex items-center justify-center px-10 py-4 rounded-full bg-background border border-border text-foreground font-semibold hover:bg-muted hover:border-muted-foreground/30 transition-all duration-300 group"
            >
                <span>Descargar CV</span>
                <svg class="w-4 h-4 ml-2 text-muted-foreground group-hover:text-foreground transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
            </a>
        </div>
    </div>

    <a 
        href="#about"
        class="absolute bottom-6 md:bottom-12 left-1/2 -translate-x-1/2 animate-[bounce_1.5s_infinite] p-3 rounded-full hover:bg-muted/50 border border-transparent hover:border-border/50 transition-colors duration-300 cursor-pointer group"
        aria-label="Scroll hacia abajo"
    >
        <svg class="w-7 h-7 text-muted-foreground group-hover:text-foreground transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
    </a>
</section>