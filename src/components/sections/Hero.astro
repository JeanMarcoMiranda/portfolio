---
// Hero.astro - Minimalista y Profesional
import { Clock, Rocket, Code2, Globe } from "lucide-astro";

const roles = [
  "Desarrollador Mobile",
  "Frontend Specialist",
  "Full Stack Developer",
  "UI/UX Enthusiast",
];

const metrics = [
  { value: "3+", labelId: "metric-years", label: "Años", icon: Clock },
  {
    value: "15+",
    labelId: "metric-projects",
    label: "Proyectos",
    icon: Rocket,
  },
  {
    value: "8+",
    labelId: "metric-technologies",
    label: "Tecnologías",
    icon: Code2,
  },
  { value: "100%", labelId: "metric-remote", label: "Remoto", icon: Globe },
];
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center py-16 overflow-hidden bg-background"
>
  <!-- Decoración minimalista -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute inset-0 bg-repeat opacity-[0.03]"
      style="background-image: radial-gradient(var(--color-border) 1px, transparent 1px); background-size: 20px 20px;"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-primary/8 blur-3xl rounded-full"
    >
    </div>
  </div>

  <div
    class="container relative z-10 flex flex-col items-center text-center space-y-6 max-w-4xl"
  >
    <!-- Foto de perfil compacta -->
    <div class="relative group animate-fade-in">
      <div
        class="absolute -inset-0.5 bg-gradient-to-r from-primary to-accent rounded-full blur opacity-30 group-hover:opacity-50 transition duration-300"
      >
      </div>

      <img
        src="/profile_photo.jpg"
        alt="Jean Marco Miranda profile"
        class="relative w-24 h-24 md:w-28 md:h-28 rounded-full border-2 border-background shadow-lg object-cover transition-transform duration-300 group-hover:scale-105"
      />

      <!-- Badge disponibilidad -->
      <div
        class="absolute bottom-1 right-1 w-5 h-5 bg-green-500 border-2 border-background rounded-full shadow-md"
        title="Disponible para trabajar"
      >
      </div>
    </div>

    <!-- Contenido principal -->
    <div class="space-y-4 animate-slide-up" style="animation-delay: 100ms;">
      <!-- Saludo compacto -->
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-muted/50 border border-border/50"
      >
        <span class="text-sm text-muted-foreground">
          <span id="hero-greeting">Hola, soy</span>
          <span class="text-foreground font-semibold">Jean Marco Miranda</span>
        </span>
      </div>

      <!-- Título principal con texto rotativo - Tamaños moderados -->
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground leading-tight"
      >
        <span class="block mb-2">Jean Marco Miranda</span>
        <span class="block">
          <span
            id="rotating-text"
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-primary bg-[length:200%_auto] animate-gradient inline-block min-w-[280px] sm:min-w-[350px]"
          >
            Desarrollador Mobile
          </span>
        </span>
      </h1>

      <!-- Hook mejorado -->
      <p
        class="text-sm sm:text-base text-muted-foreground max-w-2xl mx-auto leading-relaxed"
      >
        Transformo ideas complejas en <span
          class="text-foreground font-semibold">experiencias móviles y web</span
        > que los usuarios aman usar. Especializado en <span
          class="text-foreground font-medium">Android nativo</span
        > y desarrollo frontend moderno.
      </p>
    </div>

    <!-- Métricas visuales animadas - Con iconos Lucide -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6 w-full max-w-2xl animate-slide-up"
      style="animation-delay: 200ms;"
    >
      {
        metrics.map((metric, index) => (
          <div
            class="metric-card bg-card/50 backdrop-blur-sm border border-border/50 rounded-lg p-3 text-center hover:border-primary/50 transition-all duration-300 hover:scale-105"
            style={`animation-delay: ${index * 100}ms`}
          >
            <metric.icon class="w-4 h-4 mx-auto mb-2 text-primary" />
            <div
              class="text-xl font-bold text-primary metric-number"
              data-target={metric.value}
            >
              0
            </div>
            <div class="text-xs text-muted-foreground mt-1" id={metric.labelId}>
              {metric.label}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Botones de acción -->
    <div
      class="flex flex-col sm:flex-row gap-3 pt-2 animate-slide-up"
      style="animation-delay: 200ms;"
    >
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-6 py-2.5 text-sm rounded-full bg-primary text-primary-foreground font-semibold shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:scale-[1.02] transition-all duration-300"
      >
        <span id="hero-cta-contact">Contáctame</span>
        <svg
          class="w-4 h-4 ml-2"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <a
        href="/resume.pdf"
        target="_blank"
        class="inline-flex items-center justify-center px-6 py-2.5 text-sm rounded-full bg-card border border-border text-foreground font-semibold hover:bg-muted hover:border-primary/30 transition-all duration-300 group"
      >
        <span>Descargar CV</span>
        <svg
          class="w-4 h-4 ml-2 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
      </a>
    </div>

    <!-- Links sociales compactos (NUEVA SECCIÓN) -->
    <div
      class="flex items-center gap-3 pt-4 animate-fade-in"
      style="animation-delay: 300ms;"
    >
      <a
        href="https://github.com/yourusername"
        target="_blank"
        class="w-9 h-9 flex items-center justify-center rounded-full bg-card border border-border hover:border-primary/50 hover:bg-muted transition-all duration-300 group"
        aria-label="GitHub"
      >
        <svg
          class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>
      <a
        href="https://linkedin.com/in/yourusername"
        target="_blank"
        class="w-9 h-9 flex items-center justify-center rounded-full bg-card border border-border hover:border-primary/50 hover:bg-muted transition-all duration-300 group"
        aria-label="LinkedIn"
      >
        <svg
          class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
      <a
        href="mailto:your.email@example.com"
        class="w-9 h-9 flex items-center justify-center rounded-full bg-card border border-border hover:border-primary/50 hover:bg-muted transition-all duration-300 group"
        aria-label="Email"
      >
        <svg
          class="w-4 h-4 text-muted-foreground group-hover:text-foreground transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator minimalista -->
  <a
    href="#about"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce p-2 rounded-full hover:bg-muted/50 transition-colors duration-300 cursor-pointer group"
    aria-label="Scroll hacia abajo"
  >
    <svg
      class="w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </a>
</section>

<script define:vars={{ roles }}>
  // Texto rotativo
  const textElement = document.getElementById("rotating-text");
  let currentIndex = 0;

  function rotateText() {
    if (!textElement) return;

    // Fade out
    textElement.style.opacity = "0";
    textElement.style.transform = "translateY(-10px)";

    setTimeout(() => {
      currentIndex = (currentIndex + 1) % roles.length;
      textElement.textContent = roles[currentIndex];

      // Fade in
      textElement.style.opacity = "1";
      textElement.style.transform = "translateY(0)";
    }, 300);
  }

  // Iniciar rotación después de 3 segundos
  setInterval(rotateText, 3000);
</script>

<script>
  // Animación de conteo para métricas
  const metricNumbers = document.querySelectorAll(".metric-number");

  const animateValue = (element: Element, target: string) => {
    const isPercentage = target.includes("%");
    const isPlus = target.includes("+");
    const numericTarget = parseInt(target);
    const duration = 2000;
    const steps = 60;
    const increment = numericTarget / steps;
    let current = 0;

    const timer = setInterval(() => {
      current += increment;
      if (current >= numericTarget) {
        current = numericTarget;
        clearInterval(timer);
      }
      element.textContent =
        Math.floor(current) + (isPlus ? "+" : "") + (isPercentage ? "%" : "");
    }, duration / steps);
  };

  // Intersection Observer para animar cuando sea visible
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target.getAttribute("data-target");
          if (target) animateValue(entry.target, target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 },
  );

  metricNumbers.forEach((el) => observer.observe(el));
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }

  .animate-gradient {
    animation: gradient 3s ease infinite;
  }

  #rotating-text {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .metric-card {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
