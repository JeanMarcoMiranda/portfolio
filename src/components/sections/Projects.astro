---
// Projects.astro - Sección de Proyectos
import { projects } from "../../data/projects";
import { Users, Star, ExternalLink } from 'lucide-astro';

const webProjects = projects.filter((p) => p.type === "web");
const mobileProjects = projects.filter((p) => p.type === "mobile");
---

<section
  id="projects"
  class="section relative py-16 md:py-20 bg-background overflow-hidden"
>
  <!-- Decoración de fondo -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div
      class="absolute top-1/4 -right-32 w-64 h-64 bg-accent/5 blur-3xl rounded-full"
    >
    </div>
    <div
      class="absolute bottom-1/4 -left-32 w-64 h-64 bg-primary/5 blur-3xl rounded-full"
    >
    </div>
  </div>

  <div class="container relative z-10">
    <!-- Header -->
    <div class="text-center mb-10">
      <h2
        class="text-2xl sm:text-3xl font-bold text-foreground mb-3 tracking-tight"
      >
        Proyectos Destacados
      </h2>
      <p class="text-sm text-muted-foreground max-w-2xl mx-auto">
        Una selección de mis trabajos más recientes en desarrollo web y móvil
      </p>
    </div>

    <!-- Tabs -->
    <div
      class="flex justify-center gap-2 mb-8 border-b border-border/30 pb-2"
    >
      <button
        data-tab="web"
        class="tab-btn active px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300"
      >
        Web
      </button>
      <button
        data-tab="mobile"
        class="tab-btn px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300"
      >
        Mobile
      </button>
    </div>

    <!-- Contenido de tabs -->
    <div class="relative">
      <!-- Panel Web -->
      <div
        id="web-panel"
        data-panel="web"
        class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-slide-up"
      >
        {
          webProjects.map((project) => (
            <article class="group relative bg-card border border-border rounded-xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:border-primary/50 hover:-translate-y-1">
              
              <!-- Imagen compacta -->
              <div class="relative h-48 overflow-hidden bg-muted">
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                
                <!-- Featured badge -->
                {project.featured && (
                  <div class="absolute top-3 left-3 px-2.5 py-1 bg-accent text-accent-foreground text-xs font-semibold rounded-full shadow-md flex items-center gap-1">
                    <Star class="w-3 h-3" />
                    Destacado
                  </div>
                )}
                
                <!-- Link icon sobre la imagen -->
                {project.link && (
                  <a 
                    href={project.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    aria-label={`Ver proyecto ${project.title}`}
                    class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-background/90 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-primary hover:text-primary-foreground"
                  >
                    <ExternalLink class="w-4 h-4" />
                  </a>
                )}
              </div>

              <!-- Contenido mejorado -->
              <div class="p-5 flex flex-col">
                <div class="flex items-start justify-between mb-2">
                  <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors">
                    {project.title}
                  </h3>
                  {project.year && (
                    <span class="text-xs text-muted-foreground font-medium">{project.year}</span>
                  )}
                </div>
               
                <!-- Challenge (storytelling) -->
                <p class="text-sm text-muted-foreground mb-3 leading-relaxed line-clamp-2">
                  <strong class="text-foreground">Desafío:</strong> {project.challenge}
                </p>
                
                <!-- Métricas con iconos -->
                {project.metrics && (
                  <div class="flex gap-3 mb-3 p-2.5 bg-muted/50 rounded-lg">
                    <div class="flex items-center gap-1.5">
                      <Users class="w-3.5 h-3.5 text-primary" />
                      <span class="text-xs font-semibold text-primary">{project.metrics.users}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Star class="w-3.5 h-3.5 text-primary" />
                      <span class="text-xs font-semibold text-primary">{project.metrics.rating}</span>
                    </div>
                  </div>
                )}
                
                <!-- Tags compactos -->
                <div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-border/30">
                  {project.tags.slice(0, 4).map((tag) => (
                    <span class="text-xs font-medium bg-secondary/50 text-secondary-foreground px-2.5 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Panel Mobile -->
      <div
        id="mobile-panel"
        data-panel="mobile"
        class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 justify-items-center gap-6 lg:gap-8 animate-slide-up"
      >
        {
          mobileProjects.map((project) => (
            <article class="flex flex-col items-center group w-full">
              
              <!-- Mockup compacto -->
              <div class="relative w-[180px] h-[360px] bg-slate-900 rounded-[2rem] border-[10px] border-slate-700 shadow-xl overflow-hidden group-hover:shadow-primary/20 transition-all duration-300 transform group-hover:-translate-y-2">
                
                <!-- Notch compacto -->
                <div class="absolute top-0 inset-x-0 h-6 bg-slate-700 z-20 flex justify-center">
                  <div class="w-20 h-4 bg-slate-900 rounded-b-lg"></div>
                </div>
                
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover pt-6"
                />
                
                <div class="absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent pointer-events-none z-10"></div>
              </div>

              <!-- Info compacta -->
              <div class="text-center mt-4 max-w-full px-2">
                <h3 class="text-sm font-bold text-foreground mb-1 group-hover:text-primary transition-colors line-clamp-1">
                  {project.title}
                </h3>
                <p class="text-xs text-muted-foreground mb-2 line-clamp-2">
                  {project.challenge}
                </p>
                
                <!-- Métricas móviles -->
                {project.metrics && (
                  <div class="flex justify-center gap-2 mb-2">
                    <span class="text-[10px] font-semibold text-primary">{project.metrics.users}</span>
                    <span class="text-[10px] text-muted-foreground">•</span>
                    <span class="text-[10px] font-semibold text-primary flex items-center gap-0.5">
                      <Star class="w-2.5 h-2.5" /> {project.metrics.rating}
                    </span>
                  </div>
                )}
                
                <div class="flex flex-wrap justify-center gap-1">
                  {project.tags.slice(0, 2).map((tag) => (
                    <span class="text-[10px] font-medium bg-secondary/50 text-secondary-foreground px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                  {project.tags.length > 2 && (
                    <span class="text-[10px] font-medium bg-muted text-muted-foreground px-2 py-0.5 rounded-full">
                      +{project.tags.length - 2}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switcher
  const tabButtons = document.querySelectorAll('.tab-btn');
  const webPanel = document.getElementById('web-panel');
  const mobilePanel = document.getElementById('mobile-panel');

  function handleSwitch(event: Event) {
    const clickedButton = (event.target as HTMLElement).closest('.tab-btn');
    if (!clickedButton) return;

    const tabToShow = clickedButton.getAttribute('data-tab');

    // Update button styles
    tabButtons.forEach(btn => {
      btn.classList.remove('bg-primary', 'text-primary-foreground');
      btn.classList.add('bg-card', 'text-muted-foreground');
    });
    clickedButton.classList.remove('bg-card', 'text-muted-foreground');
    clickedButton.classList.add('bg-primary', 'text-primary-foreground');

    // Show/hide panels
    if (tabToShow === 'web') {
      webPanel?.classList.remove('hidden');
      webPanel?.classList.add('grid');
      mobilePanel?.classList.add('hidden');
      mobilePanel?.classList.remove('grid');
    } else {
      webPanel?.classList.add('hidden');
      webPanel?.classList.remove('grid');
      mobilePanel?.classList.remove('hidden');
      mobilePanel?.classList.add('grid');
    }
  }

  tabButtons.forEach(btn => btn.addEventListener('click', handleSwitch));
</script>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }
</style>
