---
// Projects.astro - Glassmorphism Style
import { projects } from "../../data/projects";
import { Users, Star, ExternalLink, Sparkles } from "lucide-astro";

const webProjects = projects.filter((p) => p.type === "web");
const mobileProjects = projects.filter((p) => p.type === "mobile");
---

<section
  id="projects"
  class="section relative py-20 md:py-32 overflow-hidden"
  style="background: linear-gradient(to bottom, hsl(var(--muted)), hsl(var(--background)) 30%, hsl(var(--background)) 70%, hsl(var(--muted)) 100%);"
>
  <!-- Efectos de fondo glassmorphism -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary/8 rounded-full blur-3xl animate-pulse-slow"
    >
    </div>
    <div
      class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-accent/8 rounded-full blur-3xl animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <div class="container relative z-10 max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div
      class="text-center mb-16 md:mb-20 animate-fade-down"
      style="animation-delay: 0.1s;"
    >
      <div class="flex items-center justify-center gap-4 mb-6">
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 backdrop-blur-sm border border-primary/20"
        >
          <Sparkles class="w-4 h-4 text-primary" />
          <span
            class="text-xs font-semibold text-primary uppercase tracking-wider"
          >
            Portfolio
          </span>
        </div>
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
      </div>

      <h2
        id="projects-title"
        class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4"
      >
        <span class="block text-foreground">Proyectos</span>
        <span
          class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary to-primary/60"
        >
          Destacados
        </span>
      </h2>

      <p
        id="projects-subtitle"
        class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto"
      >
        Una selección de mis trabajos más recientes que demuestran mi
        experiencia en desarrollo web y móvil
      </p>
    </div>

    <!-- Tabs glassmorphism -->
    <div
      class="flex justify-center gap-3 mb-12 animate-fade-up"
      style="animation-delay: 0.2s;"
    >
      <button
        data-tab="web"
        id="projects-tab-web"
        class="tab-btn active group relative px-6 sm:px-8 py-3 text-sm sm:text-base font-semibold rounded-2xl transition-all duration-300 overflow-hidden"
      >
        <!-- Background activo -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-primary to-primary/80 opacity-100 transition-opacity duration-300"
        >
        </div>
        <!-- Background inactivo -->
        <div
          class="absolute inset-0 bg-card/50 backdrop-blur-xl border border-border/50 opacity-0 transition-opacity duration-300"
        >
        </div>
        <span class="relative z-10 flex items-center gap-2">
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
            ></path>
          </svg>
          Web
        </span>
      </button>

      <button
        data-tab="mobile"
        id="projects-tab-mobile"
        class="tab-btn group relative px-6 sm:px-8 py-3 text-sm sm:text-base font-semibold rounded-2xl transition-all duration-300 overflow-hidden"
      >
        <!-- Background activo -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-primary to-primary/80 opacity-0 transition-opacity duration-300"
        >
        </div>
        <!-- Background inactivo -->
        <div
          class="absolute inset-0 bg-card/50 backdrop-blur-xl border border-border/50 opacity-100 transition-opacity duration-300"
        >
        </div>
        <span class="relative z-10 flex items-center gap-2">
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
            ></path>
          </svg>
          Mobile
        </span>
      </button>
    </div>

    <!-- Contenido de tabs -->
    <div class="relative">
      <!-- Panel Web -->
      <div
        id="web-panel"
        data-panel="web"
        class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8"
      >
        {
          webProjects.map((project, index) => (
            <article
              class="group relative animate-slide-up"
              style={`animation-delay: ${0.3 + index * 0.1}s;`}
            >
              {/* Glow effect */}
              <div class="absolute -inset-1 bg-gradient-to-r from-primary/20 to-accent/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

              {/* Card principal */}
              <div class="relative bg-card/50 backdrop-blur-xl border border-border/50 rounded-3xl overflow-hidden hover:border-primary/30 transition-all duration-500 hover:scale-[1.02] shadow-lg hover:shadow-2xl">
                {/* Imagen */}
                <div class="relative h-56 sm:h-64 overflow-hidden bg-muted/30">
                  <img
                    src={project.imageUrl}
                    alt={project.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />

                  {/* Overlay gradient */}
                  <div class="absolute inset-0 bg-gradient-to-t from-background via-background/50 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500" />

                  {/* Featured badge */}
                  {project.featured && (
                    <div class="absolute top-4 left-4 px-3 py-1.5 bg-accent/90 backdrop-blur-md text-accent-foreground text-xs font-semibold rounded-full shadow-lg flex items-center gap-1.5 border border-accent-foreground/10">
                      <Star class="w-3.5 h-3.5 fill-current" />
                      Destacado
                    </div>
                  )}

                  {/* Link icon */}
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Ver proyecto ${project.title}`}
                      class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-full bg-background/90 backdrop-blur-md border border-border/30 opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-primary hover:border-primary hover:text-primary-foreground hover:scale-110"
                    >
                      <ExternalLink class="w-4 h-4" />
                    </a>
                  )}

                  {/* Year badge */}
                  {project.year && (
                    <div class="absolute bottom-4 right-4 px-3 py-1 bg-background/80 backdrop-blur-md rounded-full border border-border/30">
                      <span class="text-xs font-semibold text-foreground">
                        {project.year}
                      </span>
                    </div>
                  )}
                </div>

                {/* Contenido */}
                <div class="p-6 lg:p-7 flex flex-col gap-4">
                  {/* Título */}
                  <h3 class="text-xl sm:text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
                    {project.title}
                  </h3>

                  {/* Challenge */}
                  <p class="text-sm sm:text-base text-muted-foreground leading-relaxed line-clamp-2">
                    <strong class="text-foreground font-semibold">
                      Desafío:
                    </strong>{" "}
                    {project.challenge}
                  </p>

                  {/* Métricas */}
                  {project.metrics && (
                    <div class="flex gap-4 p-3 bg-muted/30 backdrop-blur-sm rounded-xl border border-border/30">
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
                          <Users class="w-4 h-4 text-primary" />
                        </div>
                        <div class="flex flex-col">
                          <span class="text-xs text-muted-foreground">
                            Usuarios
                          </span>
                          <span class="text-sm font-bold text-foreground">
                            {project.metrics.users}
                          </span>
                        </div>
                      </div>

                      <div class="w-px bg-border/30" />

                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
                          <Star class="w-4 h-4 text-primary" />
                        </div>
                        <div class="flex flex-col">
                          <span class="text-xs text-muted-foreground">
                            Rating
                          </span>
                          <span class="text-sm font-bold text-foreground">
                            {project.metrics.rating}
                          </span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* Tags */}
                  <div class="flex flex-wrap gap-2 pt-2 border-t border-border/30">
                    {project.tags.slice(0, 4).map((tag) => (
                      <span class="text-xs font-medium bg-secondary/50 backdrop-blur-sm text-secondary-foreground px-3 py-1.5 rounded-full border border-border/20 hover:border-primary/30 transition-colors">
                        {tag}
                      </span>
                    ))}
                    {project.tags.length > 4 && (
                      <span class="text-xs font-medium bg-muted/50 text-muted-foreground px-3 py-1.5 rounded-full border border-border/20">
                        +{project.tags.length - 4}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Panel Mobile -->
      <div
        id="mobile-panel"
        data-panel="mobile"
        class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8"
      >
        {
          mobileProjects.map((project, index) => (
            <article
              class="flex flex-col items-center group animate-slide-up"
              style={`animation-delay: ${0.3 + index * 0.1}s;`}
            >
              {/* Glow effect para móvil */}
              <div class="absolute -inset-4 bg-primary/20 rounded-[3rem] blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

              {/* Mockup de teléfono glassmorphism */}
              <div class="relative w-[160px] sm:w-[180px] h-[320px] sm:h-[360px]">
                {/* Frame del teléfono con glassmorphism */}
                <div class="absolute inset-0 bg-gradient-to-br from-slate-800/90 to-slate-900/90 backdrop-blur-xl rounded-[2.5rem] border-[12px] border-slate-700/50 shadow-2xl overflow-hidden group-hover:shadow-primary/20 transition-all duration-500 transform group-hover:-translate-y-2 group-hover:scale-105">
                  {/* Notch mejorado */}
                  <div class="absolute top-0 inset-x-0 h-7 bg-slate-800/90 backdrop-blur-sm z-20 flex justify-center">
                    <div class="w-24 h-5 bg-slate-900 rounded-b-2xl flex items-center justify-center gap-1">
                      <div class="w-1 h-1 rounded-full bg-slate-600" />
                      <div class="w-12 h-1 rounded-full bg-slate-700" />
                    </div>
                  </div>

                  {/* Imagen de la app */}
                  <div class="relative w-full h-full pt-7">
                    <img
                      src={project.imageUrl}
                      alt={project.title}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>

                  {/* Glass overlay */}
                  <div class="absolute inset-0 bg-gradient-to-tr from-white/5 via-transparent to-white/5 pointer-events-none z-10" />

                  {/* Screen reflection */}
                  <div class="absolute top-8 left-2 right-2 h-16 bg-gradient-to-b from-white/10 to-transparent rounded-t-3xl pointer-events-none z-10" />
                </div>

                {/* Featured badge para móvil */}
                {project.featured && (
                  <div class="absolute -top-2 -right-2 w-8 h-8 bg-accent rounded-full flex items-center justify-center shadow-lg border-2 border-background z-30">
                    <Star class="w-4 h-4 text-accent-foreground fill-current" />
                  </div>
                )}
              </div>

              {/* Info glassmorphism */}
              <div class="relative mt-6 text-center max-w-full px-2">
                <h3 class="text-sm sm:text-base font-bold text-foreground mb-2 group-hover:text-primary transition-colors line-clamp-1">
                  {project.title}
                </h3>

                <p class="text-xs sm:text-sm text-muted-foreground mb-3 line-clamp-2 leading-relaxed">
                  {project.challenge}
                </p>

                {/* Métricas móviles glassmorphism */}
                {project.metrics && (
                  <div class="flex justify-center gap-3 mb-3 p-2 bg-card/50 backdrop-blur-sm rounded-xl border border-border/30">
                    <div class="flex items-center gap-1">
                      <Users class="w-3 h-3 text-primary" />
                      <span class="text-xs font-semibold text-foreground">
                        {project.metrics.users}
                      </span>
                    </div>
                    <div class="w-px bg-border/30" />
                    <div class="flex items-center gap-1">
                      <Star class="w-3 h-3 text-primary" />
                      <span class="text-xs font-semibold text-foreground">
                        {project.metrics.rating}
                      </span>
                    </div>
                  </div>
                )}

                {/* Tags móviles */}
                <div class="flex flex-wrap justify-center gap-1.5">
                  {project.tags.slice(0, 2).map((tag) => (
                    <span class="text-[10px] sm:text-xs font-medium bg-secondary/50 backdrop-blur-sm text-secondary-foreground px-2 py-1 rounded-full border border-border/20">
                      {tag}
                    </span>
                  ))}
                  {project.tags.length > 2 && (
                    <span class="text-[10px] sm:text-xs font-medium bg-muted/50 backdrop-blur-sm text-muted-foreground px-2 py-1 rounded-full border border-border/20">
                      +{project.tags.length - 2}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Call to action opcional -->
    <div
      class="text-center mt-16 animate-fade-up"
      style="animation-delay: 0.5s;"
    >
      <div
        class="inline-flex flex-col items-center gap-4 p-6 sm:p-8 rounded-3xl border border-border/50 backdrop-blur-xl bg-card/50"
      >
        <p class="text-sm sm:text-base text-muted-foreground">
          ¿Interesado en trabajar juntos?
        </p>
        <a
          href="#contact"
          class="group relative inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base rounded-full font-semibold overflow-hidden transition-all duration-300 hover:scale-105"
        >
          <!-- Glow background -->
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary to-primary/80 opacity-90 group-hover:opacity-100 transition-opacity"
          >
          </div>

          <!-- Shimmer effect -->
          <div
            class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"
          >
          </div>

          <span
            class="relative text-primary-foreground flex items-center gap-2"
          >
            <span>Hablemos de tu proyecto</span>
            <svg
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switcher con transiciones suaves
  const tabButtons = document.querySelectorAll(".tab-btn");
  const webPanel = document.getElementById("web-panel");
  const mobilePanel = document.getElementById("mobile-panel");

  function handleSwitch(event: Event) {
    const clickedButton = (event.target as HTMLElement).closest(".tab-btn");
    if (!clickedButton) return;

    const tabToShow = clickedButton.getAttribute("data-tab");

    // Update button styles con glassmorphism
    tabButtons.forEach((btn) => {
      const activeGradient = btn.querySelector(
        ".absolute.bg-gradient-to-r.from-primary",
      );
      const inactiveBg = btn.querySelector(".absolute.bg-card\\/50");
      const text = btn.querySelector("span.relative");

      if (activeGradient && inactiveBg && text) {
        activeGradient.classList.remove("opacity-100");
        activeGradient.classList.add("opacity-0");
        inactiveBg.classList.remove("opacity-0");
        inactiveBg.classList.add("opacity-100");
        text.classList.remove("text-primary-foreground");
        text.classList.add("text-muted-foreground");
      }
    });

    // Activar botón seleccionado
    const activeGradient = clickedButton.querySelector(
      ".absolute.bg-gradient-to-r.from-primary",
    );
    const inactiveBg = clickedButton.querySelector(".absolute.bg-card\\/50");
    const text = clickedButton.querySelector("span.relative");

    if (activeGradient && inactiveBg && text) {
      activeGradient.classList.remove("opacity-0");
      activeGradient.classList.add("opacity-100");
      inactiveBg.classList.remove("opacity-100");
      inactiveBg.classList.add("opacity-0");
      text.classList.remove("text-muted-foreground");
      text.classList.add("text-primary-foreground");
    }

    // Show/hide panels con fade
    if (tabToShow === "web") {
      webPanel?.classList.remove("hidden");
      webPanel?.classList.add("grid");
      mobilePanel?.classList.add("hidden");
      mobilePanel?.classList.remove("grid");
    } else {
      webPanel?.classList.add("hidden");
      webPanel?.classList.remove("grid");
      mobilePanel?.classList.remove("hidden");
      mobilePanel?.classList.add("grid");
    }
  }

  tabButtons.forEach((btn) => btn.addEventListener("click", handleSwitch));
</script>

<style>
  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.05);
    }
  }

  .animate-fade-down {
    animation: fade-down 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-slide-up {
    animation: slide-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  /* Estilos para tabs activos/inactivos */
  .tab-btn.active span {
    color: hsl(var(--primary-foreground));
  }

  .tab-btn:not(.active) span {
    color: hsl(var(--muted-foreground));
  }
</style>
