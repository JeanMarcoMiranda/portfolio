---
// src/components/Projects.astro - Minimalista y Compacto
import { projects } from "../../data/projects.js";

const webProjects = projects.filter((p) => p.type === "web");
const mobileProjects = projects.filter((p) => p.type === "mobile");

// Estilos minimalistas para botones
const activeClasses = "bg-primary text-primary-foreground shadow-md";
const inactiveClasses = "bg-card text-muted-foreground border border-border hover:bg-muted hover:text-foreground";
const baseButtonClasses = "px-5 py-2 rounded-full text-sm font-semibold transition-all duration-300";
---

<section id="projects" class="section bg-background relative overflow-hidden py-16 lg:py-20">
  <!-- Decoración minimalista -->
  <div class="absolute top-0 right-0 w-80 h-80 bg-primary/5 blur-3xl rounded-full pointer-events-none"></div>

  <div class="container relative z-10 max-w-6xl">
    
    <!-- Header compacto -->
    <header class="text-center mb-12 animate-slide-up">
      <span class="inline-block text-xs font-semibold text-primary uppercase tracking-wider mb-2 px-3 py-1 rounded-full bg-primary/5">
        Portafolio
      </span>
      <h2 class="text-3xl lg:text-4xl font-bold text-foreground">
        Proyectos
      </h2>
    </header>

    <!-- Switcher compacto -->
    <div
      id="project-switcher"
      class="flex justify-center items-center gap-2 mb-10 animate-fade-in p-1 bg-muted/30 border border-border rounded-full max-w-fit mx-auto"
    >
      <button
        data-tab="web"
        class={`${baseButtonClasses} ${activeClasses}`}
        aria-label="Ver proyectos web"
      >
        <span class="hidden sm:inline">🖥️ </span>Web
      </button>
      <button
        data-tab="mobile"
        class={`${baseButtonClasses} ${inactiveClasses}`}
        aria-label="Ver proyectos móviles"
      >
        <span class="hidden sm:inline">📱 </span>Móvil
      </button>
    </div>

    <div class="min-h-[400px]">
      
      <!-- Panel Web -->
      <div
        id="web-panel"
        data-panel="web"
        class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 animate-slide-up"
      >
        {
          webProjects.map((project) => (
            <article class="group relative bg-card border border-border rounded-xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:border-primary/50 hover:-translate-y-1">
              
              <!-- Imagen compacta -->
              <div class="relative h-48 overflow-hidden bg-muted">
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-background/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                
                <!-- Link icon sobre la imagen -->
                {project.link && (
                  <a 
                    href={project.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    aria-label={`Ver proyecto ${project.title}`}
                    class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-background/90 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-primary hover:text-primary-foreground"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>

              <!-- Contenido compacto -->
              <div class="p-5 flex flex-col">
                <h3 class="text-lg font-bold text-foreground mb-2 group-hover:text-primary transition-colors">
                  {project.title}
                </h3>
               
                <p class="text-sm text-muted-foreground mb-4 leading-relaxed line-clamp-2">
                  {project.description}
                </p>
                
                <!-- Tags compactos -->
                <div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-border/30">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium bg-secondary/50 text-secondary-foreground px-2.5 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Panel Mobile -->
      <div
        id="mobile-panel"
        data-panel="mobile"
        class="hidden grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 justify-items-center gap-6 lg:gap-8 animate-slide-up"
      >
        {
          mobileProjects.map((project) => (
            <article class="flex flex-col items-center group w-full">
              
              <!-- Mockup compacto -->
              <div class="relative w-[180px] h-[360px] bg-slate-900 rounded-[2rem] border-[10px] border-slate-700 shadow-xl overflow-hidden group-hover:shadow-primary/20 transition-all duration-300 transform group-hover:-translate-y-2">
                
                <!-- Notch compacto -->
                <div class="absolute top-0 inset-x-0 h-6 bg-slate-700 z-20 flex justify-center">
                  <div class="w-20 h-4 bg-slate-900 rounded-b-lg"></div>
                </div>
                
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover pt-6"
                />
                
                <div class="absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent pointer-events-none z-10"></div>
              </div>

              <!-- Info compacta -->
              <div class="text-center mt-4 max-w-full px-2">
                <h3 class="text-sm font-bold text-foreground mb-1 group-hover:text-primary transition-colors line-clamp-1">
                  {project.title}
                </h3>
                <p class="text-xs text-muted-foreground mb-2 line-clamp-2">
                  {project.description}
                </p>
                <div class="flex flex-wrap justify-center gap-1">
                  {project.tags.slice(0, 2).map((tag) => (
                    <span class="text-[10px] font-medium bg-secondary/50 text-secondary-foreground px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                  {project.tags.length > 2 && (
                    <span class="text-[10px] font-medium bg-muted text-muted-foreground px-2 py-0.5 rounded-full">
                      +{project.tags.length - 2}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>

    </div>
  </div>
</section>

<script define:vars={{ activeClasses, inactiveClasses, baseButtonClasses }}>
  const switcher = document.getElementById("project-switcher");
  const buttons = switcher?.querySelectorAll("button[data-tab]");
  const webPanel = document.getElementById("web-panel");
  const mobilePanel = document.getElementById("mobile-panel");

  const activeStyles = (baseButtonClasses + ' ' + activeClasses).split(/\s+/).filter(c => c);
  const inactiveStyles = (baseButtonClasses + ' ' + inactiveClasses).split(/\s+/).filter(c => c);

  const allPanels = [webPanel, mobilePanel];
  const allTabs = Array.from(buttons || []);

  const handleSwitch = (tabToShow) => {
    allTabs.forEach((button) => {
      const isTarget = button.dataset.tab === tabToShow;
      button.classList.remove(...(isTarget ? inactiveStyles : activeStyles));
      button.classList.add(...(isTarget ? activeStyles : inactiveStyles));
      baseButtonClasses.split(/\s+/).filter(c => c).forEach(c => button.classList.add(c));
    });

    allPanels.forEach(panel => {
      const isTarget = panel.dataset.panel === tabToShow;
      if (isTarget) {
        panel.classList.remove("hidden");
        panel.style.animation = 'none';
        panel.offsetHeight;
        panel.style.animation = null; 
      } else {
        panel.classList.add("hidden");
      }
    });
  };

  handleSwitch('web'); 
  
  switcher?.addEventListener("click", (event) => {
    const clickedButton = event.target.closest("button[data-tab]");
    if (clickedButton) {
      handleSwitch(clickedButton.dataset.tab);
    }
  });
</script>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>