---
// src/components/Projects.astro - Código Optimizado
import { projects } from "../../data/projects.js";

// Filtramos los datos
const webProjects = projects.filter((p) => p.type === "web");
const mobileProjects = projects.filter((p) => p.type === "mobile");

// DEFINICIÓN DE ESTILOS (Tokens del sistema de diseño)
// Active: Se añade ring y shadow más definido, sin scale para mejor UX en botones
const activeClasses = "bg-primary text-primary-foreground shadow-lg shadow-primary/30 ring-2 ring-primary/50";
// Inactive: Mejor hover, más contraste al pasar el ratón
const inactiveClasses = "bg-muted/50 text-muted-foreground border border-border/50 hover:bg-muted hover:text-foreground";

// Clase común para ambos botones
const baseButtonClasses = "px-7 py-3 rounded-full text-base font-semibold transition-all duration-300 transform";
---

<section id="projects" class="section bg-background relative overflow-hidden">
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-[600px] h-[600px] bg-accent/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="container relative z-10">
    
    <header class="text-center mb-14 lg:mb-20 animate-slide-up">
      <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">
        Portafolio
      </p>
      <h2 class="text-4xl sm:text-5xl font-bold text-foreground">
        Mis Proyectos
      </h2>
    </header>

    <div
      id="project-switcher"
      class="flex justify-center items-center gap-4 mb-14 animate-fade-in p-1 bg-muted/30 border border-border/50 rounded-full max-w-fit mx-auto"
    >
      <button
        data-tab="web"
        class={`${baseButtonClasses} ${activeClasses}`}
        aria-label="Ver proyectos web"
      >
        🖥️ Proyectos Web
      </button>
      <button
        data-tab="mobile"
        class={`${baseButtonClasses} ${inactiveClasses}`}
        aria-label="Ver proyectos móviles"
      >
        📱 Proyectos Móviles
      </button>
    </div>

    <div class="min-h-[500px]">
      
      <div
        id="web-panel"
        data-panel="web"
        class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12 animate-slide-up"
      >
        {
          webProjects.map((project) => (
            <article class="group relative bg-card border border-border rounded-2xl shadow-xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-primary/10 hover:border-primary/50">
              
              <div class="relative h-60 overflow-hidden bg-muted">
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>

              <div class="p-6 md:p-8 flex flex-col h-full">
                <div class="flex justify-between items-start mb-3">
                   <h3 class="text-xl lg:text-2xl font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                    {project.title}
                  </h3>
                  <a href={project.link || "#"} target="_blank" rel="noopener noreferrer" aria-label={`Ver proyecto ${project.title}`} class="p-2 -mt-2 rounded-full hover:bg-muted transition-colors">
                     <svg class="w-6 h-6 text-muted-foreground group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
               
                <p class="text-muted-foreground mb-6 text-base leading-relaxed line-clamp-3">
                  {project.description}
                </p>
                
                <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-border/50">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium bg-secondary text-secondary-foreground px-3 py-1 rounded-full border border-secondary/50">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div
        id="mobile-panel"
        data-panel="mobile"
        class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 justify-items-center gap-10 lg:gap-12 animate-slide-up"
      >
        {
          mobileProjects.map((project) => (
            <article class="flex flex-col items-center group w-full max-w-xs">
              
              <div class="relative w-[280px] h-[560px] bg-slate-900 rounded-[3rem] border-[14px] border-slate-700 shadow-2xl overflow-hidden group-hover:shadow-primary/30 transition-all duration-300 transform group-hover:-translate-y-2">
                
                <div class="absolute top-0 inset-x-0 h-8 bg-slate-700 z-20 flex justify-center">
                    <div class="w-32 h-6 bg-slate-900 rounded-b-xl border-b-2 border-slate-600"></div>
                </div>
                
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover pt-8"
                />
                
                <div class="absolute inset-0 bg-gradient-to-tr from-white/10 to-transparent pointer-events-none z-10"></div>
              </div>

              <div class="text-center mt-6 max-w-full">
                <h3 class="text-xl font-bold text-foreground mb-2 group-hover:text-primary transition-colors">
                  {project.title}
                </h3>
                <p class="text-base text-muted-foreground mb-4 line-clamp-2">
                  {project.description}
                </p>
                <div class="flex flex-wrap justify-center gap-2">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium bg-secondary text-secondary-foreground px-3 py-1 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

    </div>
  </div>
</section>

<script define:vars={{ activeClasses, inactiveClasses, baseButtonClasses }}>
  
  const switcher = document.getElementById("project-switcher");
  const buttons = switcher?.querySelectorAll("button[data-tab]");
  const webPanel = document.getElementById("web-panel");
  const mobilePanel = document.getElementById("mobile-panel");

  // Combinamos base + activo/inactivo para el manejo de clases
  const activeStyles = (baseButtonClasses + ' ' + activeClasses).split(/\s+/).filter(c => c);
  const inactiveStyles = (baseButtonClasses + ' ' + inactiveClasses).split(/\s+/).filter(c => c);

  const allPanels = [webPanel, mobilePanel];
  const allTabs = Array.from(buttons || []);

  const handleSwitch = (tabToShow) => {
    
    // 1. Actualizar Botones
    allTabs.forEach((button) => {
      const isTarget = button.dataset.tab === tabToShow;
      
      // Aplicar/remover estilos activos e inactivos
      button.classList.remove(...(isTarget ? inactiveStyles : activeStyles));
      button.classList.add(...(isTarget ? activeStyles : inactiveStyles));
      
      // Asegurar que las clases base (como px-7, py-3, etc.) siempre estén
      baseButtonClasses.split(/\s+/).filter(c => c).forEach(c => button.classList.add(c));
    });

    // 2. Actualizar Paneles con animación
    allPanels.forEach(panel => {
      const isTarget = panel.dataset.panel === tabToShow;
      
      if (isTarget) {
        panel.classList.remove("hidden");
        // Reiniciar animación para que aparezca
        panel.style.animation = 'none';
        panel.offsetHeight; // Forzar reflow
        panel.style.animation = null; 
      } else {
        panel.classList.add("hidden");
      }
    });
  };

  // Inicializar el estado (asegurar que 'web' está activo al cargar)
  handleSwitch('web'); 
  
  switcher?.addEventListener("click", (event) => {
    const clickedButton = event.target.closest("button[data-tab]");
    if (clickedButton) {
        handleSwitch(clickedButton.dataset.tab);
    }
  });
</script>