---
// Projects.astro - Glassmorphism Style OPTIMIZED
import { projects } from "../../data/projects";
import {
  Star,
  ExternalLink,
  Sparkles,
  Github,
  Lock,
  Globe,
  Smartphone,
} from "lucide-astro";

const webProjects = projects.filter((p) => p.type === "web");
const mobileProjects = projects.filter((p) => p.type === "mobile");
---

<section
  id="projects"
  class="section relative py-20 md:py-32 overflow-hidden"
  style="background: linear-gradient(to bottom, hsl(var(--muted)), hsl(var(--background)) 30%, hsl(var(--background)) 70%, hsl(var(--muted)) 100%);"
>
  <!-- Efectos de fondo glassmorphism -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary/8 rounded-full blur-3xl animate-pulse-slow"
    >
    </div>
    <div
      class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-accent/8 rounded-full blur-3xl animate-pulse-slow"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <div class="container relative z-10 max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div
      class="text-center mb-16 md:mb-20 animate-fade-down"
      style="animation-delay: 0.1s;"
    >
      <div class="flex items-center justify-center gap-4 mb-6">
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 backdrop-blur-sm border border-primary/20"
        >
          <Sparkles class="w-4 h-4 text-primary" />
          <span
            class="text-xs font-semibold text-primary uppercase tracking-wider"
          >
            Portfolio
          </span>
        </div>
        <div
          class="h-px flex-1 max-w-24 bg-gradient-to-r from-transparent via-border to-transparent"
        >
        </div>
      </div>

      <h2
        id="projects-title"
        class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4"
      >
        <span class="block text-foreground">Proyectos</span>
        <span
          class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary to-primary/60"
        >
          Destacados
        </span>
      </h2>

      <p
        id="projects-subtitle"
        class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto"
      >
        Una selección de mis trabajos más recientes que demuestran mi
        experiencia en desarrollo web y móvil
      </p>
    </div>

    <!-- TABS SLIDER PREMIUM -->
    <div
      class="flex justify-center mb-12 animate-fade-up"
      style="animation-delay: 0.2s;"
    >
      <div
        class="relative inline-flex items-center p-1.5 rounded-full bg-muted/30 border border-border/40 backdrop-blur-md shadow-inner"
      >
        <!-- Glider (Background activo animado) -->
        <div
          id="tab-glider"
          class="absolute top-1.5 bottom-1.5 left-1.5 rounded-full bg-primary shadow-lg shadow-primary/25 transition-all duration-500 cubic-bezier(0.4, 0, 0.2, 1)"
          style="width: calc(50% - 6px); transform: translateX(0);"
        >
          <!-- Brillo interno del glider -->
          <div
            class="absolute inset-0 bg-gradient-to-tr from-white/20 to-transparent rounded-full"
          >
          </div>
        </div>

        <!-- Botón Web -->
        <button
          data-tab="web"
          class="tab-btn relative z-10 px-8 py-2.5 text-sm sm:text-base font-bold rounded-full transition-colors duration-300 text-primary-foreground"
        >
          <span class="flex items-center gap-2">
            <Globe class="w-4 h-4" />
            Web
          </span>
        </button>

        <!-- Botón Mobile -->
        <button
          data-tab="mobile"
          class="tab-btn relative z-10 px-8 py-2.5 text-sm sm:text-base font-bold rounded-full transition-colors duration-300 text-muted-foreground hover:text-foreground"
        >
          <span class="flex items-center gap-2">
            <Smartphone class="w-4 h-4" />
            Mobile
          </span>
        </button>
      </div>
    </div>

    <!-- Contenido de tabs -->
    <div class="relative">
      <!-- Panel Web MEJORADO -->
      <div
        id="web-panel"
        data-panel="web"
        class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8"
      >
        {
          webProjects.map((project, index) => (
            <article
              class="group relative animate-slide-up h-full"
              style={`animation-delay: ${0.3 + index * 0.1}s;`}
            >
              {/* Glow effect mejorado */}
              <div class="absolute -inset-0.5 bg-gradient-to-r from-primary/30 via-accent/30 to-primary/30 rounded-[1.75rem] blur-xl opacity-0 group-hover:opacity-100 transition-all duration-700" />

              {/* Card principal con mejor estructura */}
              <div class="relative h-full bg-card/70 backdrop-blur-xl border border-border/50 rounded-[1.5rem] overflow-hidden hover:border-primary/40 transition-all duration-500 shadow-xl hover:shadow-2xl flex flex-col">
                {/* Imagen con overlay mejorado */}
                <div class="relative h-64 sm:h-72 overflow-hidden bg-gradient-to-br from-muted/50 to-muted">
                  <img
                    src={project.imageUrl}
                    alt={project.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
                  />

                  {/* Overlay con gradiente más suave */}
                  <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent" />

                  {/* Badges superiores reorganizados */}
                  <div class="absolute top-4 left-4 right-4 flex items-start justify-between gap-2">
                    {project.featured && (
                      <div class="px-3 py-1.5 bg-gradient-to-r from-accent to-accent/90 backdrop-blur-md text-accent-foreground text-xs font-bold rounded-full shadow-lg flex items-center gap-1.5 border border-accent-foreground/20">
                        <Star class="w-3.5 h-3.5 fill-current" />
                        Destacado
                      </div>
                    )}

                    {project.year && (
                      <div class="ml-auto px-3 py-1.5 bg-background/80 backdrop-blur-md rounded-full border border-border/50 shadow-md">
                        <span class="text-xs font-bold text-foreground">
                          {project.year}
                        </span>
                      </div>
                    )}
                  </div>

                  {/* Botón de vista mejorado */}
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Ver proyecto ${project.title}`}
                      class="absolute bottom-4 right-4 w-12 h-12 flex items-center justify-center rounded-full bg-primary/90 backdrop-blur-md border border-primary/30 opacity-0 group-hover:opacity-100 transition-all duration-300 hover:scale-110 shadow-lg hover:shadow-primary/50"
                    >
                      <ExternalLink class="w-5 h-5 text-primary-foreground" />
                    </a>
                  )}
                </div>

                {/* Contenido con mejor espaciado */}
                <div class="flex-1 p-6 lg:p-7 flex flex-col gap-4">
                  {/* Título más prominente */}
                  <div>
                    <h3 class="text-2xl sm:text-2xl font-bold text-foreground group-hover:text-primary transition-colors duration-300 mb-2">
                      {project.title}
                    </h3>

                    {/* Línea decorativa sutil */}
                    <div class="h-1 w-16 bg-gradient-to-r from-primary to-transparent rounded-full opacity-70 group-hover:w-24 transition-all duration-500" />
                  </div>

                  {/* Challenge con mejor tipografía */}
                  <div class="flex-1">
                    <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
                      <span class="text-foreground font-semibold">
                        Desafío:
                      </span>{" "}
                      <span class="line-clamp-3">{project.challenge}</span>
                    </p>
                  </div>

                  {/* Tags rediseñados - más compactos */}
                  <div class="flex flex-wrap gap-2">
                    {project.tags.slice(0, 4).map((tag) => (
                      <span class="text-xs font-semibold bg-secondary/60 backdrop-blur-sm text-secondary-foreground px-3 py-1.5 rounded-lg border border-border/30 hover:border-primary/40 hover:bg-secondary/80 transition-all duration-300">
                        {tag}
                      </span>
                    ))}
                    {project.tags.length > 4 && (
                      <span class="text-xs font-semibold bg-muted/60 text-muted-foreground px-3 py-1.5 rounded-lg border border-border/30">
                        +{project.tags.length - 4}
                      </span>
                    )}
                  </div>

                  {/* Actions footer mejorado */}
                  <div class="flex items-center justify-between gap-3 pt-4 border-t border-border/30">
                    <div class="flex gap-2 flex-1">
                      {project.link && (
                        <a
                          href={project.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 transition-all duration-300 hover:scale-105 hover:shadow-lg"
                        >
                          <ExternalLink class="w-4 h-4" />
                          Ver Demo
                        </a>
                      )}
                      {project.github && (
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold rounded-xl bg-card/50 text-foreground border border-border hover:border-primary/50 hover:bg-card transition-all duration-300 hover:scale-105"
                        >
                          <Github class="w-4 h-4" />
                          Código
                        </a>
                      )}
                    </div>

                    {project.isPrivate && (
                      <div
                        class="flex items-center gap-1.5 text-xs font-semibold text-muted-foreground px-3 py-2 rounded-lg bg-muted/40 border border-border/30"
                        title="Proyecto Empresarial Privado"
                      >
                        <Lock class="w-3.5 h-3.5" />
                        <span class="hidden sm:inline">Privado</span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Panel Mobile MEJORADO -->
      <div
        id="mobile-panel"
        data-panel="mobile"
        class="hidden grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10"
      >
        {
          mobileProjects.map((project, index) => (
            <article
              class="flex flex-col items-center group animate-slide-up"
              style={`animation-delay: ${0.3 + index * 0.1}s;`}
            >
              {/* Glow effect para móvil mejorado */}
              <div class="absolute -inset-6 bg-gradient-to-b from-primary/20 via-accent/20 to-primary/20 rounded-[4rem] blur-2xl opacity-0 group-hover:opacity-100 transition-all duration-700" />

              {/* Mockup de teléfono mejorado */}
              <div class="relative w-[200px] h-[400px] mb-6">
                {/* Frame del teléfono con glassmorphism mejorado */}
                <div class="absolute inset-0 bg-gradient-to-br from-stone-800 via-stone-850 to-stone-900 backdrop-blur-xl rounded-[3rem] border-[14px] border-stone-700/60 shadow-2xl overflow-hidden group-hover:shadow-primary/30 transition-all duration-500 transform group-hover:-translate-y-3 group-hover:scale-105">
                  {/* Notch más realista */}
                  <div class="absolute top-0 inset-x-0 h-8 bg-stone-900/95 backdrop-blur-sm z-20 flex justify-center">
                    <div class="w-28 h-6 bg-stone-950 rounded-b-3xl flex items-center justify-center gap-2 shadow-inner">
                      <div class="w-1.5 h-1.5 rounded-full bg-blue-500/40" />
                      <div class="w-14 h-1 rounded-full bg-stone-800" />
                    </div>
                  </div>

                  {/* Imagen de la app */}
                  <div class="relative w-full h-full pt-8">
                    <img
                      src={project.imageUrl}
                      alt={project.title}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  </div>

                  {/* Glass overlay mejorado */}
                  <div class="absolute inset-0 bg-gradient-to-tr from-white/[0.03] via-transparent to-white/[0.08] pointer-events-none z-10" />

                  {/* Screen reflection más sutil */}
                  <div class="absolute top-8 left-3 right-3 h-20 bg-gradient-to-b from-white/5 to-transparent rounded-t-3xl pointer-events-none z-10" />

                  {/* Botones laterales del teléfono */}
                  <div class="absolute -left-[14px] top-24 w-1 h-12 bg-stone-600 rounded-l-sm" />
                  <div class="absolute -left-[14px] top-40 w-1 h-8 bg-stone-600 rounded-l-sm" />
                  <div class="absolute -right-[14px] top-28 w-1 h-16 bg-stone-600 rounded-r-sm" />
                </div>

                {/* Featured badge mejorado */}
                {project.featured && (
                  <div class="absolute -top-3 -right-3 w-10 h-10 bg-gradient-to-br from-accent to-accent/80 rounded-full flex items-center justify-center shadow-xl border-[3px] border-background z-30 animate-bounce-subtle">
                    <Star class="w-5 h-5 text-accent-foreground fill-current" />
                  </div>
                )}
              </div>

              {/* Info card con glassmorphism */}
              <div class="relative w-full max-w-[280px] p-5 rounded-2xl bg-card/60 backdrop-blur-xl border border-border/50 shadow-lg group-hover:border-primary/40 transition-all duration-500">
                <h3 class="text-lg font-bold text-foreground mb-2 group-hover:text-primary transition-colors line-clamp-1">
                  {project.title}
                </h3>

                <p class="text-sm text-muted-foreground mb-4 line-clamp-2 leading-relaxed">
                  {project.challenge}
                </p>

                {/* Actions mejoradas */}
                <div class="flex flex-col gap-3 mb-4">
                  <div class="flex items-center gap-2">
                    {project.link && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 transition-all duration-300 hover:scale-105"
                      >
                        <ExternalLink class="w-4 h-4" />
                        Demo
                      </a>
                    )}
                    {project.github && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold rounded-xl bg-card text-foreground border border-border hover:border-primary/50 transition-all duration-300 hover:scale-105"
                      >
                        <Github class="w-4 h-4" />
                        Código
                      </a>
                    )}
                  </div>

                  {project.isPrivate && (
                    <div class="flex items-center justify-center gap-2 text-xs font-semibold text-muted-foreground py-2 px-3 rounded-lg bg-muted/30 border border-border/20">
                      <Lock class="w-3.5 h-3.5" />
                      Proyecto Privado
                    </div>
                  )}
                </div>

                {/* Tags móviles mejorados */}
                <div class="flex flex-wrap justify-center gap-2">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs font-semibold bg-secondary/60 text-secondary-foreground px-3 py-1 rounded-lg border border-border/30">
                      {tag}
                    </span>
                  ))}
                  {project.tags.length > 3 && (
                    <span class="text-xs font-semibold bg-muted/60 text-muted-foreground px-3 py-1 rounded-lg border border-border/30">
                      +{project.tags.length - 3}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Call to action opcional -->
    <div
      class="text-center mt-16 animate-fade-up"
      style="animation-delay: 0.5s;"
    >
      <div
        class="inline-flex flex-col items-center gap-4 p-6 sm:p-8 rounded-3xl border border-border/50 backdrop-blur-xl bg-card/50"
      >
        <p class="text-sm sm:text-base text-muted-foreground">
          ¿Interesado en trabajar juntos?
        </p>

        <a
          href="#contact"
          class="group relative inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base rounded-full font-semibold overflow-hidden transition-all duration-300 hover:scale-105"
        >
          <!-- Glow background -->
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary to-primary/80 opacity-90 group-hover:opacity-100 transition-opacity"
          >
          </div>

          <!-- Shimmer effect -->
          <div
            class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/20 to-transparent"
          >
          </div>

          <span
            class="relative text-primary-foreground flex items-center gap-2"
          >
            <span>Hablemos de tu proyecto</span>
            <svg
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switcher con efecto Slider 'Glider'
  const tabButtons = document.querySelectorAll(".tab-btn");
  const tabGlider = document.getElementById("tab-glider");
  const webPanel = document.getElementById("web-panel");
  const mobilePanel = document.getElementById("mobile-panel");

  function handleSwitch(event: Event) {
    const clickedButton = (event.target as HTMLElement).closest(".tab-btn");
    if (!clickedButton) return;

    const tabToShow = clickedButton.getAttribute("data-tab");

    // Mover el glider
    if (tabGlider) {
      if (tabToShow === "web") {
        tabGlider.style.transform = "translateX(0)";
      } else {
        tabGlider.style.transform = "translateX(100%)";
      }
    }

    // Actualizar colores de texto
    tabButtons.forEach((btn) => {
      if (btn === clickedButton) {
        btn.classList.remove("text-muted-foreground", "hover:text-foreground");
        btn.classList.add("text-primary-foreground");
      } else {
        btn.classList.add("text-muted-foreground", "hover:text-foreground");
        btn.classList.remove("text-primary-foreground");
      }
    });

    // Show/hide panels con fade suave
    if (tabToShow === "web") {
      // Fade out mobile
      mobilePanel?.classList.add("opacity-0", "translate-y-4");

      setTimeout(() => {
        mobilePanel?.classList.add("hidden");
        mobilePanel?.classList.remove("grid");

        webPanel?.classList.remove("hidden");
        webPanel?.classList.add("grid");
        // Trigger reflow
        void webPanel?.offsetWidth;

        webPanel?.classList.remove("opacity-0", "translate-y-4");
      }, 300);
    } else {
      // Fade out web
      webPanel?.classList.add("opacity-0", "translate-y-4");

      setTimeout(() => {
        webPanel?.classList.add("hidden");
        webPanel?.classList.remove("grid");

        mobilePanel?.classList.remove("hidden");
        mobilePanel?.classList.add("grid");
        // Trigger reflow
        void mobilePanel?.offsetWidth;

        mobilePanel?.classList.remove("opacity-0", "translate-y-4");
      }, 300);
    }
  }

  tabButtons.forEach((btn) => btn.addEventListener("click", handleSwitch));
</script>

<style>
  @keyframes fade-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.05);
    }
  }

  @keyframes bounce-subtle {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .animate-fade-down {
    animation: fade-down 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-fade-up {
    animation: fade-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-slide-up {
    animation: slide-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  .animate-bounce-subtle {
    animation: bounce-subtle 2s ease-in-out infinite;
  }

  /* Transición suave para los paneles */
  #web-panel,
  #mobile-panel {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
