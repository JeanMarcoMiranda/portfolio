---
// src/components/Projects.astro

// 1. Importamos los datos
import { projects } from "../../data/projects.js";

// 2. Filtramos los proyectos en el servidor.
//    Esto es muy eficiente, el cliente no tiene que hacer este trabajo.
const webProjects = projects.filter((p) => p.type === "web");
const mobileProjects = projects.filter((p) => p.type === "mobile");

// 3. Clases de Tailwind para los botones
//    Las definimos aquí para mantener el script limpio
const activeClasses = "bg-blue-600 text-white shadow-lg";
const inactiveClasses = "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300";
---

<section
  id="projects"
  class="min-h-screen bg-gray-50 dark:bg-gray-800 py-12 sm:py-16 lg:py-20 px-4 sm:px-6 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto">
    <header class="text-center mb-12 sm:mb-16">
      <p
        class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2 font-medium"
      >
        Portafolio
      </p>
      <h2
        class="text-4xl sm:text-5xl lg:text-6xl font-serif text-gray-900 dark:text-white transition-colors"
      >
        Mis Proyectos
      </h2>
    </header>

    <div
      id="project-switcher"
      class="flex justify-center items-center space-x-4 mb-10 sm:mb-12"
    >
      <button
        data-tab="web"
        class={`px-6 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300 ${activeClasses}`}
      >
        🖥️ Proyectos Web
      </button>
      <button
        data-tab="mobile"
        class={`px-6 py-2 rounded-full text-sm sm:text-base font-medium transition-all duration-300 ${inactiveClasses}`}
      >
        📱 Proyectos Móviles
      </button>
    </div>

    <div>
      <div
        id="web-panel"
        data-panel="web"
        class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10"
      >
        {
          webProjects.map((project) => (
            <article class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden group transition-all duration-300 hover:shadow-2xl">
              <img
                src={project.imageUrl}
                alt={project.title}
                loading="lazy"
                class="w-full h-56 object-cover"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
                  {project.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm leading-relaxed">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div
        id="mobile-panel"
        data-panel="mobile"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 justify-items-center gap-8 sm:gap-10 hidden"
      >
        {
          mobileProjects.map((project) => (
            <article class="flex flex-col items-center group">
              {/* Marco del teléfono */}
              <div class="relative w-64 h-[500px] bg-gray-900 dark:bg-gray-800 rounded-[2.5rem] border-[14px] border-gray-900 dark:border-gray-800 shadow-xl overflow-hidden group-hover:shadow-2xl transition-shadow">
                <div class="absolute top-0 inset-x-0 h-8 bg-gray-900 dark:bg-gray-800 z-10">
                  <div class="absolute top-2 left-1/2 -translate-x-1/2 w-32 h-4 bg-gray-950 dark:bg-gray-900 rounded-b-lg" />
                </div>
                <img
                  src={project.imageUrl}
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-top"
                />
              </div>
              {/* Texto debajo del teléfono */}
              <div class="text-center mt-4 w-64">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                  {project.title}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 mb-3">
                  {project.description}
                </p>
                <div class="flex flex-wrap justify-center gap-2">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script define:vars={{ activeClasses, inactiveClasses }}>
  // Seleccionamos los elementos del DOM
  const switcher = document.getElementById("project-switcher");
  const buttons = switcher.querySelectorAll("button[data-tab]");
  const webPanel = document.getElementById("web-panel");
  const mobilePanel = document.getElementById("mobile-panel");

  // Clases de estilo pasadas desde el frontmatter de Astro
  // Usamos 'split' porque vienen como una sola cadena
  const activeStyles = activeClasses.split(" ");
  const inactiveStyles = inactiveClasses.split(" ");

  // Agregamos un 'listener' al contenedor de los botones
  switcher.addEventListener("click", (event) => {
    const clickedButton = event.target.closest("button[data-tab]");

    // Si no se hizo clic en un botón, no hacer nada
    if (!clickedButton) return;

    const tabToShow = clickedButton.dataset.tab; // "web" o "mobile"

    // 1. Actualizar estilos de los botones
    buttons.forEach((button) => {
      if (button === clickedButton) {
        button.classList.add(...activeStyles);
        button.classList.remove(...inactiveStyles);
        button.setAttribute("aria-pressed", "true");
      } else {
        button.classList.remove(...activeStyles);
        button.classList.add(...inactiveStyles);
        button.setAttribute("aria-pressed", "false");
      }
    });

    // 2. Mostrar/Ocultar los paneles
    if (tabToShow === "web") {
      webPanel.classList.remove("hidden");
      mobilePanel.classList.add("hidden");
    } else {
      mobilePanel.classList.remove("hidden");
      webPanel.classList.add("hidden");
    }
  });
</script>