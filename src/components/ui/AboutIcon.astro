---
// src/components/AboutIcon.astro
// Este componente recibe el nombre de un icono y renderiza el SVG correspondiente.

interface Props {
  icon: string; // "code", "education", o "projects"
  class?: string; // Para pasar clases de Tailwind
}

const { icon, class: className } = Astro.props;
---

{
  /*
    Usamos un bloque de renderizado condicional para mostrar el SVG
    correcto basado en la 'prop' de 'icon'.
    Pasamos 'className' para que podamos estilizar el SVG desde fuera.
  */
}
{icon === "code" && (
  <svg
    class:list={[
      className,
      "text-gray-900 dark:text-white transition-colors", // Clase específica del icono "code"
    ]}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
    />
  </svg>
)}

{icon === "education" && (
  <svg
    class:list={[
      className,
      "text-gray-700 dark:text-gray-300 transition-colors", // Clases de los otros iconos
    ]}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
    />
  </svg>
)}

{icon === "projects" && (
  <svg
    class:list={[
      className,
      "text-gray-700 dark:text-gray-300 transition-colors",
    ]}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
    />
  </svg>
)}