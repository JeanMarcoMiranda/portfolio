---
/**
 * @file [...slug].astro
 * @description Página dinámica catch-all para el blog.
 *
 * Soporta dos modos:
 * 1. Post normal (sin campo `series` en frontmatter) → renderiza igual que antes
 * 2. Post de serie (con campo `series`) → renderiza con sidebar de índice,
 *    breadcrumb contextual y navegación prev/next entre páginas de la serie.
 *
 * Rutas generadas:
 *   /blog/nestjs-primeros-pasos                   → post normal
 *   /blog/nestjs-curso/01-instalacion-y-estructura → página de serie
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeriesIndex from "../../components/blog/SeriesIndex.astro";
import SeriesNavigation from "../../components/blog/SeriesNavigation.astro";
import SeriesBreadcrumb from "../../components/blog/SeriesBreadcrumb.astro";
import { ArrowLeft, Calendar, Tag } from "lucide-astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => {
    // El slug puede ser "nestjs-primeros-pasos" o "nestjs-curso/01-instalacion"
    // Astro Content Collections v2+ usa `post.id` para la ruta completa con subcarpetas
    const slugPath = post.id.replace(/\.md$/, "");
    return {
      params: { slug: slugPath },
      props: { post },
    };
  });
}

const { post } = Astro.props;

// Renderizar el contenido markdown
let Content: any;
if (typeof render === "function") {
  const rendered = await render(post);
  Content = rendered.Content;
} else {
  // @ts-ignore — compatibilidad con versiones anteriores de Astro
  const rendered = await post.render();
  Content = rendered.Content;
}

// Determinar si es un post de serie
const isSeries = !!post.data.series;

// Si es una serie, cargar todos los posts de esa serie para el índice y la navegación
let seriesPosts: any[] = [];
let prevPost: any = undefined;
let nextPost: any = undefined;
let currentIndex = 0;

if (isSeries) {
  const allPosts = await getCollection("blog");

  // Filtrar solo los posts de esta serie
  seriesPosts = allPosts
    .filter((p) => p.data.series === post.data.series)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

  // Encontrar la posición actual y calcular prev/next
  currentIndex = seriesPosts.findIndex((p) => p.id === post.id);
  prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : undefined;
  nextPost =
    currentIndex < seriesPosts.length - 1
      ? seriesPosts[currentIndex + 1]
      : undefined;

  // Normalizar slugs para la navegación (igual que en getStaticPaths)
  if (prevPost) prevPost = { ...prevPost, slug: prevPost.id.replace(/\.md$/, "") };
  if (nextPost) nextPost = { ...nextPost, slug: nextPost.id.replace(/\.md$/, "") };

  // También normalizamos los slugs del array de series para SeriesIndex
  seriesPosts = seriesPosts.map((p) => ({
    ...p,
    slug: p.id.replace(/\.md$/, ""),
  }));
}

// El slug del post actual (normalizado)
const currentSlug = post.id.replace(/\.md$/, "");

// Extraer el slug de la serie (primer segmento del slug del post)
const seriesSlug = post.data.series ?? "";
---

<BaseLayout
  title={`${post.data.title} | Jean Marco Miranda`}
  description={post.data.description}
>
  <article class={`pt-24 pb-20 md:pt-32 md:pb-32 min-h-screen relative overflow-hidden ${isSeries ? "is-series" : ""}`}>

    <!-- Efecto de fondo glassmorphism -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute top-40 left-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[100px] animate-pulse-slow"></div>
    </div>

    {isSeries ? (
      <!-- ============================================================ -->
      <!-- MODO SERIE: layout con sidebar lateral                        -->
      <!-- ============================================================ -->
      <div class="series-layout container relative z-10 px-4 sm:px-6 lg:px-8">

        <!-- Sidebar de índice de la serie (sticky) -->
        <SeriesIndex
          seriesPosts={seriesPosts}
          currentSlug={currentSlug}
          seriesTitle={post.data.seriesTitle ?? "Serie"}
        />

        <!-- Contenido principal -->
        <div class="series-content">

          <!-- Navegación y metadatos -->
          <div class="mb-8 animate-fade-down" style="animation-delay: 0.1s;">

            <!-- Botón de regreso al blog -->
            <a
              href="/blog"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border/50 bg-card/50 backdrop-blur-sm text-sm font-medium text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors mb-6 group"
            >
              <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
              Volver al blog
            </a>

            <!-- Breadcrumb: Blog > Serie > Fase > Paso -->
            <SeriesBreadcrumb
              seriesSlug={seriesSlug}
              seriesTitle={post.data.seriesTitle ?? "Serie"}
              phaseTitle={post.data.phaseTitle}
              stepTitle={post.data.stepTitle}
            />

            <!-- Banner de la serie -->
            <div class="series-banner">
              <div class="series-banner-content">
                <span class="series-banner-label">
                  Fase {post.data.phase} · Paso {post.data.step} de {seriesPosts.length}
                </span>
                <span class="series-banner-series">{post.data.seriesTitle}</span>
              </div>
            </div>

            <!-- Metadatos -->
            <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-6">
              <div class="flex items-center gap-1.5 bg-muted/50 px-3 py-1.5 rounded-full border border-border/50 shadow-sm">
                <Calendar class="w-4 h-4 text-primary" />
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap items-center gap-2">
                  <Tag class="w-4 h-4 text-primary/60" />
                  {post.data.tags.map((tag: string) => (
                    <span class="bg-secondary/60 text-secondary-foreground shadow-sm px-2.5 py-1 rounded-lg border border-border/30 font-medium text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <!-- Título del paso -->
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-4 leading-tight">
              {post.data.title}
            </h1>

            <p class="text-lg text-muted-foreground leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <!-- Divider -->
          <div class="h-px w-full bg-gradient-to-r from-transparent via-border to-transparent mb-10 animate-fade-in" style="animation-delay: 0.2s;"></div>

          <!-- Contenido Markdown -->
          <div class="prose max-w-none animate-slide-up" style="animation-delay: 0.3s;">
            <Content />
          </div>

          <!-- Navegación prev/next -->
          <SeriesNavigation
            prevPost={prevPost}
            nextPost={nextPost}
            currentIndex={currentIndex}
            totalPages={seriesPosts.length}
          />
        </div>
      </div>

    ) : (
      <!-- ============================================================ -->
      <!-- MODO POST NORMAL: layout original sin cambios                 -->
      <!-- ============================================================ -->
      <div class="container relative z-10 max-w-4xl px-4 sm:px-6 lg:px-8">

        <!-- Navegación y metadatos -->
        <div class="mb-10 animate-fade-down" style="animation-delay: 0.1s;">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border/50 bg-card/50 backdrop-blur-sm text-sm font-medium text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors mb-8 group"
          >
            <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
            Volver al blog
          </a>

          <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-6">
            <div class="flex items-center gap-1.5 bg-muted/50 px-3 py-1.5 rounded-full border border-border/50 shadow-sm">
              <Calendar class="w-4 h-4 text-primary" />
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("es-ES", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </div>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <Tag class="w-4 h-4 text-primary/60" />
                {post.data.tags.map((tag: string) => (
                  <span class="bg-secondary/60 text-secondary-foreground shadow-sm px-2.5 py-1 rounded-lg border border-border/30 font-medium text-xs">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6 leading-tight">
            {post.data.title}
          </h1>
          <p class="text-xl text-muted-foreground leading-relaxed font-medium">
            {post.data.description}
          </p>
        </div>

        <div class="h-px w-full bg-gradient-to-r from-transparent via-border to-transparent mb-12 animate-fade-in" style="animation-delay: 0.2s;"></div>

        <!-- Contenido Markdown -->
        <div class="prose max-w-none animate-slide-up" style="animation-delay: 0.3s;">
          <Content />
        </div>
      </div>
    )}

  </article>
</BaseLayout>

<style>
  /* ── Animaciones ── */
  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(1.1); }
  }

  .animate-fade-down  { animation: fade-down  0.8s ease-out forwards; opacity: 0; }
  .animate-slide-up   { animation: slide-up   0.8s ease-out forwards; opacity: 0; }
  .animate-fade-in    { animation: fade-in    0.8s ease-out forwards; opacity: 0; }
  .animate-pulse-slow { animation: pulse-slow 5s   ease-in-out infinite; }

  /* ── Layout de Serie: sidebar + contenido ── */
  .series-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    max-width: 1280px;
  }

  .series-content {
    flex: 1;
    min-width: 0; /* Evita overflow en flex */
    max-width: 780px;
  }

  /* En pantallas pequeñas, sidebar va arriba (se oculta y usa colapsable) */
  @media (max-width: 1024px) {
    .series-layout {
      flex-direction: column;
    }

    /* El sidebar se convierte en un panel horizontal compacto */
    :global(.series-sidebar) {
      position: static !important;
      width: 100% !important;
      max-height: none !important;
      max-width: 100%;
      overflow: hidden;
    }

    :global(.series-sidebar .sidebar-nav) {
      display: none; /* oculto por defecto en móvil */
    }

    :global(.series-sidebar.is-open .sidebar-nav) {
      display: flex; /* visible cuando está abierto */
    }

    :global(.sidebar-mobile-toggle) {
      display: flex !important;
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border: none;
      background: color-mix(in srgb, var(--muted) 50%, transparent);
      border-radius: 50%;
      cursor: pointer;
      color: var(--muted-foreground);
      transition: all 0.2s ease;
    }
    :global(.sidebar-mobile-toggle:hover) {
      background: color-mix(in srgb, var(--primary) 15%, transparent);
      color: var(--primary);
    }
    :global(.series-sidebar) {
      position: relative !important;
    }
    :global(.series-sidebar.is-open .sidebar-mobile-toggle) {
      transform: rotate(90deg);
    }
  }

  /* ── Banner de la serie ── */
  .series-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    margin-bottom: 1.25rem;
  }

  .series-banner-content {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .series-banner-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .series-banner-series {
    font-size: 0.8rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--primary) 80%, var(--foreground));
  }
</style>

<script>
  // Toggle del sidebar en móvil
  const toggleBtn = document.getElementById("series-sidebar-toggle");
  const sidebar = document.getElementById("series-sidebar");

  if (toggleBtn && sidebar) {
    toggleBtn.addEventListener("click", () => {
      const isOpen = sidebar.classList.toggle("is-open");
      toggleBtn.setAttribute("aria-expanded", String(isOpen));
    });
  }
</script>
