---
/**
 * @file [seriesSlug]/index.astro
 * @description Página de overview para una serie completa.
 * Ruta: /blog/[seriesSlug]/
 *
 * Muestra todas las fases y pasos de la serie con un diseño premium,
 * estadísticas de la serie y un botón para iniciar/continuar desde el principio.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ArrowLeft, BookOpen, ArrowRight } from "lucide-astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  // Encontrar todas las series únicas
  const seriesIds = [
    ...new Set(
      allPosts
        .filter((p) => p.data.series)
        .map((p) => p.data.series as string)
    ),
  ];

  return seriesIds.map((seriesId) => {
    const seriesPosts = allPosts
      .filter((p) => p.data.series === seriesId)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

    const firstPost = seriesPosts[0];

    return {
      params: { seriesSlug: seriesId },
      props: {
        seriesId,
        seriesTitle: firstPost.data.seriesTitle ?? seriesId,
        seriesDescription: firstPost.data.description,
        seriesTags: firstPost.data.tags ?? [],
        seriesPosts: seriesPosts.map((p) => ({
          ...p,
          slug: p.id.replace(/\.md$/, ""),
        })),
        pubDate: firstPost.data.pubDate,
      },
    };
  });
}

const { seriesId, seriesTitle, seriesDescription, seriesTags, seriesPosts, pubDate } =
  Astro.props;

// Agrupar posts por fase
const phases = seriesPosts.reduce(
  (acc: any, post: any) => {
    const phaseNum = post.data.phase ?? 1;
    const phaseTitle = post.data.phaseTitle ?? `Fase ${phaseNum}`;
    if (!acc[phaseNum]) {
      acc[phaseNum] = { title: phaseTitle, posts: [] };
    }
    acc[phaseNum].posts.push(post);
    return acc;
  },
  {} as Record<number, { title: string; posts: any[] }>
);

const phaseEntries = Object.entries(phases).sort(
  ([a], [b]) => Number(a) - Number(b)
);

const totalPages = seriesPosts.length;
const totalPhases = phaseEntries.length;
const firstPostSlug = seriesPosts[0]?.slug ?? "";
---

<BaseLayout
  title={`${seriesTitle} | Jean Marco Miranda`}
  description={seriesDescription}
>
  <main class="pt-24 pb-20 md:pt-32 md:pb-32 min-h-screen relative overflow-hidden">

    <!-- Fondo glassmorphism -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute top-40 left-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="absolute bottom-20 right-0 w-[400px] h-[400px] bg-primary/3 rounded-full blur-[120px] animate-pulse-slow" style="animation-delay: 2.5s;"></div>
    </div>

    <div class="container relative z-10 max-w-4xl px-4 sm:px-6 lg:px-8">

      <!-- Botón de regreso al blog -->
      <div class="mb-10 animate-fade-down">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border/50 bg-card/50 backdrop-blur-sm text-sm font-medium text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors group"
        >
          <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          Volver al blog
        </a>
      </div>

      <!-- Cabecera de la serie -->
      <div class="mb-12 animate-fade-down" style="animation-delay: 0.1s;">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 mb-6">
          <BookOpen class="w-4 h-4 text-primary" />
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">
            Serie completa · {totalPhases} {totalPhases === 1 ? "fase" : "fases"} · {totalPages} páginas
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 leading-tight">
          <span class="block text-foreground">{seriesTitle}</span>
        </h1>

        <p class="text-lg text-muted-foreground max-w-2xl mb-8 leading-relaxed">
          {seriesDescription}
        </p>

        <!-- Tags -->
        {seriesTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {seriesTags.map((tag: string) => (
              <span class="text-xs font-semibold bg-secondary/60 text-secondary-foreground px-3 py-1.5 rounded-lg border border-border/30">
                {tag}
              </span>
            ))}
          </div>
        )}

        <!-- Botón CTA: empezar la serie -->
        <a
          href={`/blog/${firstPostSlug}`}
          class="cta-button group"
        >
          <span>Empezar la serie</span>
          <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <!-- Divider -->
      <div class="h-px w-full bg-gradient-to-r from-transparent via-border to-transparent mb-12 animate-fade-in" style="animation-delay: 0.2s;"></div>

      <!-- Índice de fases y pasos -->
      <div class="animate-slide-up" style="animation-delay: 0.3s;">
        <h2 class="text-xl font-bold text-foreground mb-8">Contenido de la serie</h2>

        <div class="phases-list">
          {phaseEntries.map(([phaseNum, phase]: [string, any], phaseIdx: number) => (
            <div class="phase-block">
              <!-- Cabecera de fase -->
              <div class="phase-block-header">
                <div class="phase-number-badge">
                  {phaseIdx + 1}
                </div>
                <div>
                  <div class="phase-block-label">Fase {phaseNum}</div>
                  <h3 class="phase-block-title">{phase.title}</h3>
                </div>
              </div>

              <!-- Lista de pasos -->
              <div class="steps-grid">
                {phase.posts.map((post: any, stepIdx: number) => (
                  <a
                    href={`/blog/${post.slug}`}
                    class="step-card group"
                    aria-label={`Fase ${phaseNum}, Paso ${post.data.step}: ${post.data.stepTitle ?? post.data.title}`}
                  >
                    <div class="step-card-number">
                      {post.data.step}
                    </div>
                    <div class="step-card-content">
                      <span class="step-card-meta">
                        Paso {post.data.step}
                      </span>
                      <h4 class="step-card-title">
                        {post.data.stepTitle ?? post.data.title}
                      </h4>
                      <p class="step-card-desc">{post.data.description}</p>
                    </div>
                    <div class="step-card-arrow">
                      <ArrowRight class="w-4 h-4" />
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  /* Animaciones */
  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(1.1); }
  }
  .animate-fade-down  { animation: fade-down  0.8s ease-out forwards; opacity: 0; }
  .animate-slide-up   { animation: slide-up   0.8s ease-out forwards; opacity: 0; }
  .animate-fade-in    { animation: fade-in    0.8s ease-out forwards; opacity: 0; }
  .animate-pulse-slow { animation: pulse-slow 5s ease-in-out infinite; }

  /* CTA Button */
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.5rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 0.75rem;
    text-decoration: none;
    border: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--primary) 30%, transparent);
  }
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--primary) 40%, transparent);
    background: color-mix(in srgb, var(--primary) 85%, black);
  }

  /* Fases */
  .phases-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .phase-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .phase-block-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .phase-number-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    border: 2px solid color-mix(in srgb, var(--primary) 30%, transparent);
    font-size: 1rem;
    font-weight: 800;
    color: var(--primary);
    font-family: var(--font-heading, sans-serif);
  }

  .phase-block-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary);
    margin-bottom: 0.1rem;
  }

  .phase-block-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
  }

  /* Grid de pasos */
  .steps-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.5rem;
    border-left: 2px solid color-mix(in srgb, var(--primary) 20%, transparent);
  }

  /* Tarjeta de paso */
  .step-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: var(--card);
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 1rem;
    text-decoration: none;
    color: var(--foreground);
    transition: all 0.25s ease;
  }
  .step-card:hover {
    border-color: color-mix(in srgb, var(--primary) 40%, transparent);
    background: color-mix(in srgb, var(--primary) 4%, var(--card));
    transform: translateX(4px);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--primary) 10%, transparent);
  }

  .step-card-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--primary);
    transition: all 0.25s ease;
  }
  .step-card:hover .step-card-number {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .step-card-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .step-card-meta {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted-foreground);
  }

  .step-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
    line-height: 1.3;
    transition: color 0.2s ease;
  }
  .step-card:hover .step-card-title {
    color: var(--primary);
  }

  .step-card-desc {
    font-size: 0.78rem;
    color: var(--muted-foreground);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .step-card-arrow {
    color: var(--muted-foreground);
    flex-shrink: 0;
    transition: all 0.25s ease;
    opacity: 0.5;
  }
  .step-card:hover .step-card-arrow {
    color: var(--primary);
    opacity: 1;
    transform: translateX(2px);
  }
</style>
